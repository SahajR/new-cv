---
import Layout from '../layouts/Layout.astro';
import StickyMeta from '../components/StickyMeta.astro';
import HeroWindow from '../components/HeroWindow.astro';
import Intro from '../components/Intro.astro';
import Track from '../components/Track.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <main class="folio">
    <StickyMeta />
    <div class="folio-col">
      <HeroWindow />
      <Intro />
      <Track />
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .folio {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--ink);
  }
  .folio-col {
    width: min(100% - 3rem, var(--col-w));
    margin: 0 auto;
    padding: 80px 0 168px;
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }
  @media (max-width: 1219px) {
    .folio-col {
      padding-top: 28px;
    }
  }
  @media (max-width: 620px) {
    .folio-col {
      padding-top: 3vh;
      gap: 40px;
    }
  }
</style>
