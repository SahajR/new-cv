---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <main class="folio">
    <Hero>
      <About />
    </Hero>
    <Footer />
  </main>
</Layout>

<style>
  .folio {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--ink);
    overflow-x: clip; /* objects may bleed past the edges; never a horizontal scrollbar */
  }
</style>
