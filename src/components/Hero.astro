---
/**
 * Header section: the intro title with the page content flowing directly
 * under it, and scene objects placed around. The section is the positioning
 * context for the <Scene> layer, so objects sit alongside the content.
 */
import Intro from './Intro.astro';
import Scene from './Scene.astro';
import { headerScene } from '../data/scene';
---

<section class="hero">
  <Scene objects={headerScene} />
  <div class="hero-content">
    <Intro />
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    justify-content: center;
    /* top: clear the camera hanging from the top edge; bottom: clear the fixed footer */
    padding: clamp(200px, 32vh, 340px) 1.5rem 200px;
  }
  .hero-content {
    position: relative;
    z-index: 1; /* above the scene layer (0), below the footer fade (4) */
    width: min(100%, var(--col-w));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.25rem;
  }
  @media (max-width: 760px) {
    .hero {
      padding-top: clamp(170px, 26vh, 240px);
    }
  }
</style>
