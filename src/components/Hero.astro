---
/**
 * Header section: the intro title with the page content flowing directly
 * under it, and scene objects placed around. The section is the positioning
 * context for the <Scene> layer, so objects sit alongside the content.
 */
import Intro from './Intro.astro';
import Scene from './Scene.astro';
import { headerScene } from '../data/scene';
---

<section class="hero">
  <Scene objects={headerScene} class="header-scene" entrance />
  <div class="hero-content">
    <Intro />
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    justify-content: center;
    /* top: clear the camera hanging from the top edge — its rendered height
       is width × 1.14 (see scene.ts), so never go below that plus a gap, even
       on short viewports.
       bottom: the journey rail lights up to a reading line 42% down the
       viewport, so leave the remaining 58% (plus footer room) below the last
       part — that way the whole path can light when scrolled to the bottom. */
    --camera-h: calc(clamp(140px, 16.8vw, 252px) * 1.14);
    padding: max(clamp(200px, 32vh, 340px), calc(var(--camera-h) + 40px)) 1.5rem calc(58vh + 48px);
    padding-bottom: calc(58svh + 48px);
  }
  .hero-content {
    position: relative;
    z-index: 1; /* above the scene layer (0), below the footer fade (4) */
    width: min(100%, var(--col-w));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.25rem;
  }
  @media (min-width: 761px) {
    /* Keep the expanded name and its shadows clear as the side gutters narrow.
       The image half-widths include their rotated silhouettes. min/max retain
       the original composition wherever there is already enough room. */
    .hero { --title-clearance: 14rem; }
    .hero :global(.header-scene [data-id='skydive-helmet']) {
      left: min(calc(var(--x) * 100%), calc(50% - var(--title-clearance) - var(--w) * 0.6));
    }
    .hero :global(.header-scene [data-id='dive-watch']) {
      left: max(calc(var(--x) * 100%), calc(50% + var(--title-clearance) + var(--w) * 0.61));
    }
    .hero :global(.header-scene [data-id='dive-mask']) {
      left: max(calc(var(--x) * 100%), calc(50% + var(--title-clearance) + var(--w) * 0.56));
    }
  }
  @media (max-width: 760px) {
    .hero {
      --camera-h: calc(31vw * 1.14);
      padding-top: max(clamp(170px, 26vh, 240px), calc(var(--camera-h) + 40px));
    }
  }
</style>
