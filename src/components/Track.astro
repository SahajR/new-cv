---
import { timeline } from '../data/profile';
import TimelineEntry from './TimelineEntry.astro';
import Outro from './Outro.astro';
---

<div class="folio-track" data-track>
  <div class="plan-head reveal" aria-hidden="true" style="--reveal-delay: 90ms">
    <span class="plan-label">Timeline</span>
    <svg class="plan-mark" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5" stroke="currentColor" />
      <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>

  <div class="folio-path" aria-hidden="true" data-path>
    <svg class="path-curve" viewBox="0 0 44 110" fill="none">
      <path class="pc-dots" d="M43 0V7.3A39 39 0 0 1 21.71 42.05A39 39 0 0 0 0.5 76.75V110"></path>
      <path class="pc-lit" d="M43 0V7.3A39 39 0 0 1 21.71 42.05A39 39 0 0 0 0.5 76.75V110" pathLength="1"></path>
    </svg>
    <div class="path-rail"><div class="path-lit"></div></div>
    <svg class="path-tip" viewBox="0 0 7 3" fill="none">
      <path d="M0.5 0.5 3.5 2.5 6.5 0.5"></path>
    </svg>
  </div>

  <ol class="folio-timeline">
    {timeline.map((entry, i) => <TimelineEntry entry={entry} index={i} />)}
  </ol>

  <Outro />
</div>

<script>
  /**
   * Lights the rail and the dots as the reader scrolls. The "reading line"
   * sits ~42% down the viewport; everything above it is lit.
   */
  const track = document.querySelector<HTMLElement>('[data-track]');
  const path = track?.querySelector<HTMLElement>('[data-path]');

  if (track && path) {
    const CURVE_H = 110;
    const READ_LINE = 0.42;
    const dots = Array.from(track.querySelectorAll<HTMLElement>('.tl-dot'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;

    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    const update = () => {
      raf = 0;
      const line = window.innerHeight * READ_LINE;
      const rect = path.getBoundingClientRect();
      const curveEnd = rect.top + CURVE_H;
      const railLen = rect.height - CURVE_H;

      const curveP = clamp((line - rect.top) / CURVE_H);
      const railP = railLen > 0 ? clamp((line - curveEnd) / railLen) : 0;
      path.style.setProperty('--curve-p', curveP.toFixed(4));
      path.style.setProperty('--rail-p', railP.toFixed(4));

      for (const dot of dots) {
        const r = dot.getBoundingClientRect();
        dot.classList.toggle('is-lit', r.top + r.height / 2 <= line);
      }
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    if (reduced) update();
    else requestAnimationFrame(update);
  }
</script>

<style>
  .folio-track {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 36px;
    --entry-indent: 0px;
  }

  /* Label at the top of the rail's curve */
  .plan-head {
    position: absolute;
    left: -3px;
    top: -106px;
    width: 48px;
    text-align: center;
    color: var(--accent);
  }
  .plan-label {
    display: block;
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 8px;
    line-height: 8px;
    letter-spacing: 0.76px;
    text-transform: uppercase;
  }
  .plan-mark {
    display: block;
    width: 16px;
    height: 16px;
    margin: 8px auto 0;
  }

  /* The dotted rail with a lit portion driven by --curve-p / --rail-p */
  .folio-path {
    position: absolute;
    left: calc(var(--rail-x) - 0.5px);
    top: -65px;
    bottom: 24px;
    width: 1px;
    --curve-p: 0;
    --rail-p: 0;
  }
  .path-curve {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 110px;
    overflow: visible;
  }
  .pc-dots {
    stroke: var(--rule);
    stroke-width: 1;
    stroke-dasharray: 2 3.5;
    stroke-linecap: round;
  }
  .pc-lit {
    stroke: var(--accent);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--curve-p));
    filter: drop-shadow(0 0 3px rgba(var(--accent-rgb), 0.2));
  }
  .path-rail {
    position: absolute;
    left: 0;
    top: 110px;
    bottom: 0;
    width: 1px;
    background-image: linear-gradient(to bottom, var(--rule) 0 2px, transparent 2px 5.5px);
    background-size: 1px 5.5px;
  }
  .path-lit {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: calc(var(--rail-p) * 100%);
    background: var(--accent);
    box-shadow:
      0 0 4px rgba(var(--accent-rgb), 0.2),
      0 0 10px rgba(var(--accent-rgb), 0.2),
      0 0 20px rgba(var(--accent-rgb), 0.14);
    opacity: min(1, calc(var(--rail-p) * 60));
  }
  .path-lit::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 5px;
    height: 5px;
    margin: 0 0 -2.5px -2.5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 5px 1px rgba(var(--accent-rgb), 0.2),
      0 0 12px 3px rgba(var(--accent-rgb), 0.2);
    opacity: min(1, calc((1 - var(--rail-p)) * 25));
  }
  .path-tip {
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 7px;
    height: 3px;
    transform: translateX(-50%);
    overflow: visible;
  }
  .path-tip path {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  .folio-timeline {
    list-style: none;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* Dots — global because they live inside child components */
  :global(.tl-dot) {
    position: absolute;
    left: calc(var(--rail-x) - var(--entry-indent));
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    z-index: 1;
  }
  :global(.tl-dot-now),
  :global(.tl-dot-past) {
    width: 13px;
    height: 13px;
    background: var(--bg);
    border: 1px solid var(--dot-line);
    transition: border-color 0.3s var(--ease-out);
  }
  :global(.tl-dot-now::after),
  :global(.tl-dot-past::after) {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--dot-fill);
    transition: background-color 0.3s var(--ease-out);
  }
  :global(.tl-dot-case) {
    width: 5px;
    height: 5px;
    background: var(--dot-case);
    --pulse-to: 3.6;
    transition: background-color 0.3s var(--ease-out);
  }
  :global(.tl-dot.is-lit) {
    border-color: var(--accent);
  }
  :global(.tl-dot.is-lit::after) {
    background: var(--accent);
  }
  :global(.tl-dot-case.is-lit) {
    background: var(--accent);
  }
  :global(.tl-dot::before) {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1px solid var(--accent);
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }
  :global(.tl-dot.is-lit::before) {
    animation: dotPulse 0.72s var(--ease-out);
  }
  @keyframes dotPulse {
    from {
      opacity: 0.45;
      transform: translate(-50%, -50%) scale(1);
    }
    to {
      opacity: 0;
      transform: translate(-50%, -50%) scale(var(--pulse-to, 2.4));
    }
  }

  @media (max-width: 760px) {
    .folio-track {
      --rail-x: 3.5px;
      --entry-indent: 32px;
      gap: 44px;
      margin-top: 97px;
    }
    .folio-timeline {
      gap: 48px;
    }
    .plan-head {
      left: calc(50% - 24px);
      top: -115px;
    }
    .folio-path {
      top: -74px;
    }
    .path-rail {
      top: 75px;
    }
  }
</style>
