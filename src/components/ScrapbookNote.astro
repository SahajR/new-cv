---
import type { TravelCountry } from '../data/travel';
import { isJournalCountry } from '../data/travel-journals';
import ScrapbookPhotos from './ScrapbookPhotos.astro';
interface Props { country: TravelCountry; journal?: boolean; eager?: boolean }
const { country, journal = false, eager = false } = Astro.props;
const Heading = journal ? 'h1' : 'h3';
---
{journal && isJournalCountry(country.slug) ? <>
  <Heading class="sr-only" data-book-country-title={country.page} tabindex="-1">{country.name}</Heading>
  <ScrapbookPhotos country={country.slug} eager={eager} />
</> : <div class="sb-notes">
  <span class="sb-kicker">A page from the road</span>
  <Heading class="sb-country-title" data-book-country-title={country.page} tabindex={journal ? 0 : undefined}>{country.name}</Heading>
  <p class="sb-places">{country.places}</p>
  <p class="sb-handwriting">{country.note}</p>
  <span class="sb-stamp" aria-hidden="true"><b>{country.code}</b><span>FIELD NOTES</span></span>
  <span class="sb-page-number" aria-hidden="true">{String(country.page).padStart(2, '0')}</span>
</div>}
