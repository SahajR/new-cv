---
import PaintedTravelMap from './PaintedTravelMap.astro';
import paintedBounds from '../data/china-map-art.json';
import { chinaClusters } from '../data/china';
import type { TravelStop } from '../data/travel-journals';
interface Props { stops: readonly TravelStop[]; linked?: boolean }
const { stops, linked = false } = Astro.props;
---
<PaintedTravelMap country="china" prefix="cn" stops={stops} linked={linked} bounds={paintedBounds} base={[90.86, -45.36, 551.21, 526.76]} markerScale={.23} clusters={chinaClusters} />
