---
import { japanCoastline } from '../data/japan-coastline';
import { japanCardId, type japanStops } from '../data/japan';
import '../styles/japan.css';
interface Props { stops: readonly (typeof japanStops)[number][]; linked?: boolean }
const { stops, linked = false } = Astro.props;
const trees = [[502,289],[528,286],[545,272],[572,250],[609,212],[627,199],[650,177],[673,147],[704,108],[754,93],[782,81],[803,73],[842,82],[307,356],[281,384],[389,348]];
---
<div class="japan-map" data-japan-map data-map-placement="book">
  <svg class="japan-map-canvas" data-map-canvas viewBox="0 0 900 330" role="group" aria-labelledby="japan-map-title japan-map-description">
    <title id="japan-map-title">Japan: a map of the journey</title>
    <desc id="japan-map-description">An illustrated map with {stops.length} places photographed between 30 May and 6 June 2025. Choose a landmark to jump to its photographs. Landmark illustrations are spread out for readability.</desc>
    <defs>
      <path id="jp-land" d={japanCoastline} />
      <clipPath id="jp-land-clip"><use href="#jp-land" /></clipPath>
      <g id="jp-tree"><path d="M-2 0H2V9H-2Z" fill="#74553b"/><path d="M0-19L-9-8H-5L-12 1H12L5-8H9Z" fill="#4c7960"/><path d="M0-19V1H12L5-8H9Z" fill="#345e4b"/></g>
      <g id="jp-mountain"><path d="M-25 8L0-28L25 8Z" fill="#6f8776"/><path d="M0-28L25 8H2Z" fill="#4d705f"/><path d="M0-28L10-13L4-16L0-12L-5-16L-10-13Z" fill="#f3f1d8"/></g>
      <g id="jp-wave" fill="none" stroke="#84b7b7" stroke-width="2"><path d="M0 0q5 7 10 0q5 7 10 0q5 7 10 0"/></g>
      <g id="jp-castle">
        <path d="M-29 0L-25-15H25L29 0Z" fill="#929780"/><path d="M0-15H25L29 0H0Z" fill="#667761"/>
        <path d="M-23-15V-32H23V-15M-17-37V-51H17V-37M-10-56V-67H10V-56" fill="#f3edce"/>
        <path d="M-30-32L-18-40H18L30-32Z M-23-51L-11-59H11L23-51Z M-15-67L0-78L15-67Z" fill="#3c695d"/>
        <path d="M-29-32H29M-22-51H22M-14-67H14" stroke="#d2b55b" stroke-width="3"/>
        <path d="M-14-29V-21M-5-29V-21M5-29V-21M14-29V-21M-8-48V-42M8-48V-42M0-63V-58" stroke="#475d52" stroke-width="4"/>
      </g>
      <g id="jp-temple">
        <use href="#jp-tree" transform="translate(-32 -8) scale(1.3)"/><use href="#jp-tree" transform="translate(34 -11) scale(1.45)"/>
        <path d="M-25-1V-26H25V-1Z" fill="#d5b484"/><path d="M-31-26L-17-42H17L31-26Z" fill="#3b544b"/>
        <path d="M-32-26H32M-27 0H27" stroke="#756049" stroke-width="4"/>
        <path d="M-17-23V-3M17-23V-3" stroke="#846846" stroke-width="4"/><path d="M-9-20H9V-2H-9Z" fill="#4d6255"/><path d="M0-20V-2" stroke="#ac9471" stroke-width="2"/>
        <path d="M-13 1H13V5H-13Z" fill="#96957c"/>
      </g>
      <g id="jp-sun">
        <path d="M-10 0L-6-36L-38-49L-37-56L-4-47L-3-62H4L6-47L38-56L39-49L7-36L13 0Z" fill="#eee6cb" stroke="#b7b69a" stroke-width="1.5"/>
        <circle cy="-66" r="10" fill="#d0ae51"/><path d="M-5-68H-2M3-68H6M-3-61H4" stroke="#6a6046" stroke-width="2"/>
        <circle cy="-33" r="8" fill="#f6ecd5" stroke="#a59c83"/><path d="M-4-35H-2M2-35H4M-2-30H2" stroke="#817a62" stroke-width="2"/>
        <path d="M-5-20L-1-13L-5-6M6-20L2-13L7-6" fill="none" stroke="#bc5944" stroke-width="4"/>
      </g>
      <g id="jp-dome">
        <path d="M-30 0V-28H-12V-39H12V-28H30V0Z" fill="#aaa38d"/><path d="M4-39H12V-28H30V0H4Z" fill="#858b77"/>
        <path d="M-14-39H14V-47H-14Z" fill="#c5bba2"/><path d="M-12-47Q-12-70 0-70Q12-70 12-47M0-70V-47M-12-51H12M-9-61H9" fill="none" stroke="#556a61" stroke-width="2.5"/>
        <path d="M-23-21V-14M-14-21V-14M-23-9V-2M-14-9V-2M17-21V-14M25-21V-14M17-9V-2M25-9V-2M-5-33V-22M5-33V-22M-5-15V-2M5-15V-2" stroke="#535f53" stroke-width="4"/>
      </g>
      <g id="jp-torii">
        <path d="M-23 0L-19-55H-11L-14 0M15 0L11-55H19L23 0" fill="#bc4937"/>
        <path d="M-32-55Q0-47 32-55L29-46H-29Z" fill="#384d44"/><path d="M-30-46H30V-40H-30ZM-27-29H27V-23H-27Z" fill="#d26342"/>
        <path d="M-3-40H3V-23H-3Z" fill="#b04d37"/><path d="M-24 0H-12M13 0H25" stroke="#394e45" stroke-width="5"/>
      </g>
      <g id="jp-pagoda">
        <path d="M-18 0V-18H18V0M-15-24V-36H15V-24M-11-42V-53H11V-42M-7-59V-67H7V-59" fill="#ac7150"/>
        <path d="M-28-18L-12-27H12L28-18ZM-24-36L-9-45H9L24-36ZM-20-53L-6-61H6L20-53ZM-15-67L0-75L15-67Z" fill="#425a51"/>
        <path d="M0-75V-89M-5-81H5M-4-86H4" stroke="#646548" stroke-width="2"/>
        <path d="M-10-15V0M0-15V0M10-15V0M-8-34V-25M2-34V-25M-4-51V-43" stroke="#684e3b" stroke-width="3"/>
      </g>
      <g id="jp-tower">
        <path d="M-18 0L-5-61H5L18 0Z" fill="#e4e2cc" stroke="#7f9990" stroke-width="1.5"/>
        <path d="M-8-14L9-32L-5-47M8-14L-9-32L5-47M-7-48H7M-10-34H10M-13-18H13M0-62V-91" fill="none" stroke="#96a99f" stroke-width="2"/>
        <path d="M-11-61H11L8-52H-8ZM-6-78H6V-72H-6Z" fill="#70988f"/><path d="M-11-61H11M-6-78H6" stroke="#f1eddb" stroke-width="3"/>
      </g>
      <g id="jp-buddha">
        <path d="M-29 0L-25-9H25L29 0Z" fill="#a19a80"/>
        <path d="M-25-10Q-27-20-12-23L-11-40H12L13-23Q27-20 25-10Z" fill="#5e8272"/>
        <path d="M-9-40Q-18-49-10-59Q0-68 10-59Q18-49 9-40Z" fill="#789785"/><path d="M-9-58Q0-70 9-58" fill="#496f60"/>
        <path d="M0-62V-65M-8-50H-3M3-50H8M-3-43H3M-8-37L4-22L-7-18M-16-15Q0-9 16-15" fill="none" stroke="#3f6759" stroke-width="2.5"/>
      </g>
    </defs>
    <g class="map-water" aria-hidden="true" transform="translate(-135 8) scale(1.12 .7)">
      {[ [96,280],[120,306],[790,388],[832,402],[70,190],[851,246],[795,224],[576,443],[509,53],[475,66],[200,435],[91,447] ].map(([x,y]) => <use href="#jp-wave" x={x} y={y}/>)}
      <use href="#jp-land" transform="translate(0 9)" fill="#668369" stroke="#668369" stroke-width="4" stroke-linejoin="miter"/>
      <use href="#jp-land" fill="#bed48c" stroke="#daE4b2" stroke-width="9" stroke-linejoin="miter"/>
      <use href="#jp-land" fill="#a9c878" stroke="#88ab6c" stroke-width="1.5"/>
      <g clip-path="url(#jp-land-clip)">
        <path d="M262 360L351 336L428 350L513 287L580 261L624 205L664 151L725 74L830 77" fill="none" stroke="#b8d488" stroke-width="27"/>
        <path d="M448 310L481 317L504 297L536 296L561 272L582 269L631 286" fill="none" stroke="#ecdbab" stroke-width="3" stroke-dasharray="4 5"/>
        {trees.map(([x,y]) => <use href="#jp-tree" x={x} y={y} />)}
      </g>
      <use href="#jp-mountain" transform="translate(605 275) scale(.85)"/>
      <use href="#jp-mountain" transform="translate(785 83) scale(.8)"/><use href="#jp-mountain" transform="translate(813 69) scale(.65)"/>
      <g class="map-island-names" fill="#547664"><text x="820" y="43">HOKKAIDO</text><text x="632" y="224" transform="rotate(-32 632 224)">HONSHU</text><text x="390" y="369">SHIKOKU</text><text x="264" y="419">KYUSHU</text></g>
      <g transform="translate(912 346)" class="map-compass"><path d="M0-22L-7 0H7Z" fill="#4c786e"/><path d="M0 22L-7 0H7Z" fill="#d3e3d7"/><text y="-31" text-anchor="middle">N</text></g>
    </g>
    {stops.map((stop, i) => <a href={`${linked ? '/travel/japan/' : ''}#${japanCardId(stop.id)}`} class="map-landmark" data-map-stop={stop.id} aria-label={`${stop.name}: jump to photographs`}>
      <path class="map-leader" d={`M${stop.anchor[0]} ${stop.anchor[1]}L${stop.marker[0]} ${stop.marker[1]}`} />
      <circle class="map-anchor" cx={stop.anchor[0]} cy={stop.anchor[1]} r="3" />
      <g transform={`translate(${stop.marker[0]} ${stop.marker[1]})`}>
        <rect class="map-hit-area" x="-62" y="-92" width="124" height="132" rx="4" />
        <ellipse class="map-ground" rx="38" ry="9" transform="scale(.6)" />
        <ellipse class="map-active-ring" rx="42" ry="12" />
        <g class="map-sprite"><use href={`#jp-${stop.symbol}`} transform="scale(.6)" /></g>
        <g class="map-label"><rect x="-60" y="12" width="120" height="27" rx="3"/><text x="5" y="32" text-anchor="middle">{stop.name}</text><circle cx="-54" cy="25" r="11"/><text class="map-number" x="-54" y="29" text-anchor="middle">{i+1}</text></g>
      </g>
    </a>)}
  </svg>
  <div class="japan-map-footer">
    <a class="map-book-caption" href={`${linked ? '/travel/japan/' : ''}#${stops[0] ? japanCardId(stops[0].id) : 'japan-journal-title'}`} data-place-link={stops[0]?.id}>Explore the map <span aria-hidden="true">↓</span></a>
    <span class="map-current"><span class="map-current-dot" aria-hidden="true"></span><span data-map-current>Choose a place, or follow the photographs</span></span>
    <button type="button" class="map-view-toggle" data-map-view hidden>Whole Japan <span aria-hidden="true">↗</span></button>
    <span class="map-follow-hint">Scroll to explore <span aria-hidden="true">↓</span></span>
  </div>
</div>
