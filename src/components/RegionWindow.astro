---
/**
 * A journey-region break: a dialog window naming the region, with a large
 * centred line about what's ahead. The rail passes behind it.
 */
import DialogWindow from './DialogWindow.astro';

interface Props {
  name: string;
  description?: string;
  accent: string;
}

const { name, description, accent } = Astro.props;
---

<div class="region-window" data-journey-window>
  <DialogWindow title={name} accent={accent}>
    <slot><p class="rw-text">{description}</p></slot>
  </DialogWindow>
</div>

<style>
  .region-window {
    position: relative;
    z-index: 1; /* above the rail — the line ducks behind the window */
    width: 100%;
  }
  /* The frame and title bar are always visible; the body starts collapsed
     (the window is just its bar) and expands open when the region is
     reached, while the content scales in from the top edge with a fade.
     The rail relayouts itself as the height animates (ResizeObserver). */
  .region-window :global(.dw-collapse) {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s var(--ease-out);
  }
  :global(.region-window.is-reached .dw-collapse) {
    grid-template-rows: 1fr;
  }
  .region-window :global(.dw-body) {
    /* No vertical margins while collapsed, so the closed window is exactly
       its title bar — margins would otherwise hold the track open. */
    margin-top: 0;
    margin-bottom: 0;
    opacity: 0;
    transform: scale(0.9);
    transform-origin: 50% 0;
    transition:
      margin 0.55s var(--ease-out),
      opacity 0.45s var(--ease-out),
      transform 0.55s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  :global(.region-window.is-reached .dw-body) {
    margin-top: 9px;
    margin-bottom: 9px;
    opacity: 1;
    transform: none;
  }
  /* Under reduced motion: fade only, no scale. */
  @media (prefers-reduced-motion: reduce) {
    .region-window :global(.dw-body) {
      transform: none;
      transition: opacity 0.45s var(--ease-out) !important;
    }
  }
  .rw-text {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.625rem);
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
    color: var(--ink);
    padding: clamp(28px, 4vw, 44px) clamp(20px, 4vw, 48px);
  }
</style>
