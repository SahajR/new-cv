---
import type { Achievement } from '../data/achievements';

interface Props { achievement: Achievement; index: number; }
const { achievement: a, index } = Astro.props;
const segments = Math.min(a.target, 10);
const completedSegments = a.current / a.target * segments;
const complete = Math.floor(completedSegments);
---

<li>
  <article class="achievement-card" aria-labelledby={`${a.id}-title`} style={`--card-accent: ${a.accent}`}>
    <img class="achievement-art" src={a.image} alt={a.imageAlt} width="40" height="60" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
    <div class="achievement-content">
      <p class="achievement-category"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{a.category}</p>
      <h2 id={`${a.id}-title`}>{a.title}</h2>
      <p class="achievement-description">{a.description}</p>
      <div class="achievement-progress">
        {a.measurement === 'percentage' ? (
          <div class="measurement">
            <div class="measurement-values">
              <p><strong>{a.current}%</strong><span>Current</span></p>
              <span class="measurement-arrow" aria-hidden="true">→</span>
              <p><strong>{a.target}%</strong><span>Goal</span></p>
            </div>
            <div class="measurement-meter" role="meter" aria-labelledby={`${a.id}-title`}
              aria-valuemin="0" aria-valuemax="100" aria-valuenow={a.current}
              aria-valuetext={`${a.current}% ${a.unit}; goal ${a.target}%`}
              style={`--measurement-value: ${a.current}%; --measurement-goal: ${a.target}%`}>
              <span class="measurement-fill" aria-hidden="true"></span>
              <span class="measurement-target" aria-hidden="true"></span>
            </div>
            <p class="measurement-key">Marker: {a.target}% goal</p>
          </div>
        ) : (<>
        <p class="achievement-count"><strong>{a.current}<span> / {a.target}</span></strong><span>{a.unit}</span></p>
        <div
          class="achievement-meter"
          role="progressbar"
          aria-labelledby={`${a.id}-title`}
          aria-valuemin="0"
          aria-valuemax={a.target}
          aria-valuenow={a.current}
          aria-valuetext={`${a.current} of ${a.target} ${a.unit}${a.nextInProgress ? `; ${a.status}` : ''}`}
          style={`--segments: ${segments}`}
        >
          {Array.from({ length: segments }, (_, i) => <span
            aria-hidden="true"
            class:list={['meter-block', {
              'is-complete': i < complete,
              'is-partial': i === complete && completedSegments > complete,
              'is-next': a.nextInProgress && i === complete,
            }]}
            style={`--block-fill: ${Math.max(0, Math.min(1, completedSegments - i)) * 100}%`}
          />)}
        </div>
        </>)}
        <p class:list={['achievement-status', { 'has-next': a.nextInProgress }]}>
          {a.nextInProgress && <span class="status-pattern" aria-hidden="true"></span>}{a.status}
        </p>
      </div>
    </div>
  </article>
</li>

<style>
  .achievement-card {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 28px;
    padding: 12px;
    border: 1.5px solid color-mix(in oklab, var(--ink) 58%, var(--bg));
    border-radius: 4px;
    background: color-mix(in oklab, var(--card-accent) 5%, var(--bg));
    box-shadow: -4px 5px 0 rgba(var(--shadow-rgb), .07);
  }
  .achievement-art {
    display: block;
    align-self: start;
    width: 128px;
    height: 192px;
    object-fit: cover;
    image-rendering: pixelated;
    background: color-mix(in oklab, var(--card-accent) 25%, var(--bg));
  }
  .achievement-content { min-width: 0; padding: 4px 12px 4px 0; }
  .achievement-category {
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: var(--body);
    font-size: .75rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .achievement-category > span { color: var(--body); font-variant-numeric: tabular-nums; }
  h2 { margin-top: 4px; font-size: clamp(1.6rem, 3vw, 2rem); line-height: 1.12; }
  .achievement-description { margin-top: 6px; color: var(--body); font-size: .9375rem; line-height: 1.5; }
  .achievement-progress { margin-top: 20px; }
  .achievement-count { display: flex; align-items: baseline; gap: 12px; color: var(--body); font-size: .8125rem; }
  .achievement-count strong { color: var(--ink); font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .achievement-count strong span { color: var(--body); }
  .achievement-meter { display: grid; grid-template-columns: repeat(var(--segments), minmax(0, 1fr)); gap: 4px; height: 12px; margin-top: 9px; }
  .measurement-values { display: flex; align-items: center; gap: 16px; }
  .measurement-values p { display: grid; gap: 4px; }
  .measurement-values strong { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; line-height: 1; }
  .measurement-values p span, .measurement-key { font-size: .6875rem; color: var(--body); }
  .measurement-arrow { color: var(--body); }
  .measurement-meter { position: relative; height: 12px; margin-top: 12px; border: 1px solid color-mix(in oklab, var(--ink) 32%, var(--bg)); }
  .measurement-fill { display: block; width: var(--measurement-value); height: 100%; background: var(--card-accent); }
  .measurement-target { position: absolute; left: var(--measurement-goal); top: -4px; bottom: -4px; width: 2px; transform: translateX(-50%); background: var(--ink); }
  .measurement-key { margin-top: 7px; }
  .meter-block { border: 1px solid color-mix(in oklab, var(--ink) 32%, var(--bg)); }
  .meter-block.is-complete { background: var(--card-accent); border-color: color-mix(in oklab, var(--card-accent) 65%, var(--ink)); }
  .meter-block.is-partial { background: linear-gradient(to right, var(--card-accent) var(--block-fill), transparent var(--block-fill)); border-color: color-mix(in oklab, var(--card-accent) 65%, var(--ink)); }
  .meter-block.is-next, .status-pattern { background: repeating-linear-gradient(135deg, var(--card-accent) 0 2px, transparent 2px 5px); }
  .achievement-status { display: flex; align-items: center; gap: 7px; margin-top: 8px; color: var(--body); font-size: .75rem; line-height: 1.4; }
  .status-pattern { flex: none; width: 10px; height: 10px; border: 1px solid color-mix(in oklab, var(--card-accent) 65%, var(--ink)); }
  @media (max-width: 560px) {
    .achievement-card { grid-template-columns: 80px minmax(0, 1fr); gap: 16px; padding: 10px; }
    .achievement-art { width: 80px; height: 120px; }
    .achievement-content { padding: 0; }
    h2 { font-size: 1.5rem; }
    .achievement-description { font-size: .8125rem; }
    .achievement-progress { margin-top: 16px; }
    .achievement-count { flex-wrap: wrap; gap: 4px 8px; font-size: .75rem; }
    .achievement-count strong { font-size: 1.375rem; }
    .achievement-meter { gap: 3px; }
    .achievement-category { font-size: .6875rem; gap: 8px; }
  }
</style>
