---
import { STILL_TIME, frameText, sceneStats } from '../scripts/agent-ascii-scene';

// The same scene, rendered once at build time for readers without scripts.
const still = frameText(STILL_TIME);
const stats = sceneStats(STILL_TIME);
---

<figure class="agent-ascii" data-agent-scene aria-label="Agent orchestration illustration">
  <div class="aa-screen">
    <div class="aa-readout" aria-hidden="true"><span>ORCHESTRATOR / AGENT LOOP</span><span><b data-agent-active>{stats.active}</b> / 5 AGENTS</span></div>
    <div class="aa-stage" role="img" aria-label="An animated ASCII diagram. Requests fall into a spinning orchestrator loop, which dispatches each task along a line to one of five small agents. Each agent boots a sandbox virtual machine on a server node below, makes tool calls down into the platform, and sends its result back up through the loop.">
      <pre class="aa-fallback" aria-hidden="true">{still}</pre>
      <canvas data-agent-canvas aria-hidden="true"></canvas>
      <canvas class="aa-glow" data-agent-glow aria-hidden="true"></canvas>
    </div>
    <div class="aa-foot" aria-hidden="true"><span>SANDBOX VMs / 5 NODES</span><span><b data-agent-tasks>{1280 + stats.delivered}</b> TASKS</span></div>
  </div>
  <footer class="aa-bottom">
    <span class="aa-vent" aria-hidden="true"></span>
    <span aria-hidden="true">200 × 100 ASCII</span>
    <button class="aa-pause" type="button" data-agent-pause aria-label="Pause agent animation" aria-pressed="false" hidden>
      <svg viewBox="0 0 12 12" aria-hidden="true"><path class="aa-pause-icon" d="M2 2h3v8H2zM7 2h3v8H7z" /><path class="aa-play-icon" d="M3 1v10l8-5z" /></svg>
    </button>
  </footer>
  <figcaption class="sr-only">An illustration of the work: an orchestrator hands tasks to agents, the agents run in sandboxes on shared infrastructure, and results flow back.</figcaption>
</figure>

<script>
  import { startAgentOrchestration } from '../scripts/agent-orchestration';
  document.querySelectorAll<HTMLElement>('[data-agent-scene]').forEach(startAgentOrchestration);
</script>

<style>
  .agent-ascii {
    --aa-screen: #211e33;
    --aa-edge: #355d73;
    --aa-ink: #d3d9f5;
    --aa-muted: #a4a0b9;
    --aa-pink: #e57889;
    position: relative;
    z-index: 2;
    width: 100%;
    min-width: 0;
    margin: 20px 0 4px;
    color: var(--ink);
    font-family: var(--font-serif);
    container-type: inline-size;
  }
  .aa-screen {
    position: relative;
    overflow: hidden;
    background: var(--aa-screen);
    color: var(--aa-ink);
    border-top: 6px solid var(--aa-edge);
    border-bottom: 6px solid #cbd5f7;
  }
  .aa-readout, .aa-foot {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 10px 12px 4px;
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .aa-readout > span:last-child { color: var(--aa-pink); }
  .aa-readout b { font-size: 20px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .aa-foot { color: var(--aa-muted); padding: 4px 12px 9px; font-size: 9px; }
  .aa-foot b { font-size: 12px; font-weight: 500; font-variant-numeric: tabular-nums; }

  /* 200 columns × 100 rows of 0.6em-wide cells. */
  .aa-stage {
    position: relative;
    aspect-ratio: 6 / 5;
    margin: 0 12px;
    overflow: hidden;
    container-type: inline-size;
  }
  .aa-stage canvas, .aa-fallback { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .aa-stage canvas { visibility: hidden; }
  /* A quarter-resolution copy, blurred, reads as phosphor bloom. */
  .aa-glow { filter: blur(4px); opacity: 0.7; mix-blend-mode: screen; pointer-events: none; }
  .agent-ascii[data-agent-ready] canvas { visibility: visible; }
  .agent-ascii[data-agent-ready] .aa-fallback { visibility: hidden; }
  .aa-fallback {
    margin: 0;
    color: #9d95c9;
    font: calc(100cqi / 120) / 1 ui-monospace, 'SF Mono', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    white-space: pre;
  }
  /* One faint scanline per text row. */
  .aa-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent 65%, #14102133 65%) 0 0 / 100% 1%;
  }

  .aa-bottom { display: flex; align-items: center; gap: 14px; height: 44px; color: var(--body); font-size: 10px; letter-spacing: 0.08em; }
  .aa-vent { width: 88px; height: 8px; background: repeating-linear-gradient(to right, currentColor 0 3px, transparent 3px 6px); }
  .aa-pause { display: grid; place-items: center; flex: none; width: 44px; height: 44px; margin-left: auto; padding: 0; color: var(--ink); border: 0; border-radius: 3px; background: transparent; cursor: pointer; }
  .aa-pause[hidden] { display: none; }
  .aa-pause:hover { background: color-mix(in oklab, var(--ink) 8%, transparent); }
  .aa-pause:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
  .aa-pause:active { background: color-mix(in oklab, var(--ink) 14%, transparent); }
  .aa-pause svg { display: block; width: 12px; height: 12px; fill: currentColor; }
  .aa-play-icon { display: none; }
  .aa-pause[aria-pressed='true'] .aa-pause-icon { display: none; }
  .aa-pause[aria-pressed='true'] .aa-play-icon { display: block; }

  @container (max-width: 420px) {
    .aa-readout, .aa-foot { padding-inline: 8px; font-size: 8px; }
    .aa-readout b { font-size: 17px; }
    .aa-stage { margin-inline: 8px; }
    .aa-vent { width: 44px; }
  }
</style>
