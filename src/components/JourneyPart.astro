---
import type { JourneyPart } from '../data/profile';
import { albums } from '../data/albums';
import { icons } from '../icons';
import AlbumStack from './AlbumStack';

interface Props {
  part: JourneyPart;
  side: 'left' | 'right';
  index: number;
}

const { part, side, index } = Astro.props;
---

<li class="jp" data-side={side} data-journey-part id={part.id}>
  <span class="jp-dot" aria-hidden="true" data-journey-dot>
    <svg class="jp-star" viewBox="0 0 64 64" fill="currentColor">
      <path d="M32 4 L36 26 L58 30 L36 34 L32 56 L28 34 L6 30 L28 26 Z" />
    </svg>
  </span>

  <header class="jp-head">
    <span class="jp-label label">{part.label}</span>
    <h2 class="jp-title">{part.title}</h2>
  </header>

  <div class="jp-body">
    {part.paragraphs?.map((p) => (
      <p class="jp-p">
        {typeof p === 'string'
          ? p
          : p.map((seg) => {
              const Icon = seg.icon ? icons[seg.icon] : null;
              return (
                <>
                  {seg.text}
                  {Icon && (
                    <span class="jp-icon" aria-hidden="true">
                      <Icon />
                    </span>
                  )}
                </>
              );
            })}
      </p>
    ))}

    {part.focusIntro && <p class="jp-p jp-focus-intro">{part.focusIntro}</p>}
    {part.focus && (
      <ul class="jp-focus">
        {part.focus.map((item) => <li>{item}</li>)}
      </ul>
    )}

    {part.closing && (
      <p class="jp-closing">
        {part.closing.map((c) => (
          <>
            {c.text}
            {c.album && <AlbumStack client:visible images={albums[c.album]} rotation={c.rotation} />}
          </>
        ))}
      </p>
    )}
  </div>
</li>

<style>
  .jp {
    position: relative;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    /* Room for the rail on the active side */
    padding-left: var(--jp-inset-left, 0);
    padding-right: var(--jp-inset-right, 0);
  }
  .jp[data-side='left'] {
    --jp-inset-left: var(--rail-gutter);
  }
  .jp[data-side='right'] {
    --jp-inset-right: var(--rail-gutter);
  }

  /* Scroll-in reveal */
  .jp {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
  .jp.is-in {
    opacity: 1;
    transform: none;
  }

  /* The star on the rail, level with the heading. A background disc masks
     the rail line behind it. */
  .jp-dot {
    position: absolute;
    top: 0.95em;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    color: var(--dot-fill);
    transform: translate(-50%, -50%);
    z-index: 1;
    transition: color 0.3s var(--ease-out);
  }
  .jp[data-side='left'] .jp-dot {
    left: var(--rail-x);
  }
  .jp[data-side='right'] .jp-dot {
    left: auto;
    right: var(--rail-x);
    transform: translate(50%, -50%);
  }
  .jp-star {
    width: 16px;
    height: 16px;
    display: block;
    transition: transform 0.5s var(--ease-out);
  }
  .jp-dot.is-lit {
    color: var(--region-rail, var(--rail-lit));
  }
  .jp-dot.is-lit .jp-star {
    transform: rotate(90deg) scale(1.15);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--region-rail, var(--rail-lit)) 45%, transparent));
  }
  .jp-dot::before {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    border: 1px solid var(--region-rail, var(--rail-lit));
    opacity: 0;
  }
  .jp-dot.is-lit::before {
    animation: dotPulse 0.72s var(--ease-out);
  }
  @keyframes dotPulse {
    from { opacity: 0.45; transform: scale(1); }
    to   { opacity: 0;    transform: scale(2.2); }
  }

  /* Heading */
  .jp-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .jp[data-side='right'] .jp-head {
    flex-direction: row-reverse;
    text-align: right;
  }
  .jp-label {
    color: var(--region-rail, var(--rail-lit));
    letter-spacing: 1.4px;
  }
  .jp-title {
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: 0.005em;
    color: var(--ink);
  }

  /* Body */
  .jp-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* Inline icon: sized to the text with a slight rise above the cap height,
     lit like the scene objects (top-right light, shadow down-left). */
  .jp-icon {
    display: inline-block;
    line-height: 0;
    margin: 0 0.15em 0 0.1em;
    vertical-align: -0.28em;
  }
  .jp-icon :global(svg) {
    width: 1.35em;
    height: 1.35em;
    filter: drop-shadow(-1.5px 2px 2px rgba(var(--shadow-rgb), 0.22));
  }

  .jp-p,
  .jp-focus {
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.1875rem);
    line-height: 1.65;
    letter-spacing: -0.005em;
    color: var(--body);
  }
  .jp-focus-intro {
    color: var(--ink);
  }
  .jp-focus {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1.4rem;
    line-height: 1.6;
  }
  .jp-focus li {
    position: relative;
  }
  .jp-focus li::before {
    content: '';
    position: absolute;
    left: -1.4rem;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--region-rail, var(--rail-lit));
  }
  .jp-closing {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    line-height: 1.4;
    letter-spacing: 0.005em;
    color: var(--ink);
    text-wrap: balance;
  }
  .jp[data-side='right'] .jp-closing {
    text-align: right;
  }

  @media (prefers-reduced-motion: reduce) {
    .jp {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .jp-dot.is-lit::before {
      animation: none;
    }
    .jp-star {
      transition: none;
    }
  }
</style>
