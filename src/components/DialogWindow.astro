---
/**
 * Pixel desktop window: a white titlebar, bitmap-style app mark, and three
 * beveled window controls around a slotted body.
 *
 * The body wash derives from `accent` via color-mix, so
 * it stays pastel in light mode and muted in dark mode.
 */
interface Props {
  title: string;
  /** Body-wash colour. Any CSS color. */
  accent?: string;
  class?: string;
}

const { title, accent = 'var(--accent)', class: className } = Astro.props;
---

<div class:list={['dw', className]} style={`--dw-accent: ${accent}`}>
  <header class="dw-bar">
    <svg class="dw-app" viewBox="0 0 9 5" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M0 0h5v5H0z M6 1h1v1H6z M8 1h1v1H8z M5 2h1v1H5z M6 3h1v1H6z M8 3h1v1H8z M7 4h1v1H7z" />
      <path class="dw-app-cutout" d="M1 1h1v1H1z M3 1h1v1H3z M1 3h1v1H1z M3 3h1v1H3z" />
    </svg>
    <span class="dw-title">{title}</span>
    <span class="dw-controls" aria-hidden="true">
      <span class="dw-control">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><path d="M3 11h10" /></svg>
      </span>
      <span class="dw-control">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><path d="M3 3h10v10H3z" /></svg>
      </span>
      <span class="dw-control">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><path d="m3 3 10 10m0-10L3 13" /></svg>
      </span>
    </span>
  </header>
  <div class="dw-collapse">
    <div class="dw-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .dw {
    --dw-line: color-mix(in oklab, var(--ink) 88%, var(--bg));
    --dw-wash: color-mix(in oklab, var(--dw-accent) 14%, var(--bg));
    --dw-chrome: #fff;
    --dw-chrome-ink: #252337;
    --dw-chrome-light: #fff;
    --dw-chrome-shade: #c8c6d1;
    --dw-frame: #686d70;
    width: 100%;
    border: 3px solid var(--dw-frame);
    border-radius: 0;
    background: var(--bg);
    box-shadow: 4px 5px 0 rgba(var(--shadow-rgb), 0.18);
    overflow: hidden;
  }

  .dw-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 10px 12px;
    border-bottom: 4px solid var(--dw-chrome-ink);
    background: var(--dw-chrome);
    color: var(--dw-chrome-ink);
  }
  .dw-app {
    display: block;
    width: 36px;
    height: 20px;
    flex: none;
  }
  .dw-app-cutout { fill: var(--dw-chrome); }
  .dw-title {
    flex: 1;
    min-width: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 20px;
    line-height: 1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .dw-controls {
    position: relative;
    display: flex;
    flex: none;
    gap: 6px;
    padding: 4px;
    margin-left: 12px;
    background: var(--dw-chrome-ink);
  }
  /* Full-height divider and square bevels echo the reference's pixel grid. */
  .dw-controls::before {
    content: '';
    position: absolute;
    top: -11px;
    bottom: -11px;
    left: -15px;
    width: 4px;
    background: var(--dw-frame);
    box-shadow: 4px 0 0 color-mix(in srgb, var(--dw-chrome) 70%, var(--dw-chrome-light));
  }
  .dw-control {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    background: var(--dw-chrome);
    box-shadow: inset 0 6px 0 var(--dw-chrome-light), inset 0 -6px 0 var(--dw-chrome-shade);
  }
  .dw-control svg {
    display: block;
    width: 18px;
    height: 18px;
  }
  .dw-control path {
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 480px) {
    .dw-bar {
      min-height: 56px;
      gap: 8px;
      padding: 8px;
    }
    .dw-app { width: 27px; height: 15px; }
    .dw-title { font-size: 18px; letter-spacing: 0.05em; }
    .dw-controls { gap: 4px; margin-left: 8px; }
    .dw-controls::before { top: -10px; bottom: -10px; left: -12px; }
    .dw-control {
      width: 24px;
      height: 24px;
      box-shadow: inset 0 4px 0 var(--dw-chrome-light), inset 0 -4px 0 var(--dw-chrome-shade);
    }
    .dw-control svg { width: 12px; height: 12px; }
  }

  /* Animatable-height wrapper: rows 0fr collapses the body to nothing,
     1fr opens it to natural height. Open by default; region windows start
     collapsed and expand when reached. */
  .dw-collapse {
    display: grid;
    grid-template-rows: 1fr;
    overflow: hidden;
  }
  .dw-body {
    min-height: 0;
    margin: 9px;
    border: 1px solid color-mix(in oklab, var(--dw-line) 40%, transparent);
    border-radius: 3px;
    background: var(--dw-wash);
  }
</style>
