---
import { getCountryStories } from '../lib/travel-content';
import { travelJournals, storyHref, cardId, formatVisitDate, type JournalCountry } from '../data/travel-journals';
interface Props { country: JournalCountry }
const { country } = Astro.props;
const journal = travelJournals[country];
const entries = await getCountryStories(country);
---
<section class="travel-journal" id={`${country}-journal`} data-travel-journal={country} aria-label={`${journal.name} travel stories`}>
  <div class="travel-map-dock" data-travel-map-dock></div>
  <div class="travel-stories">
    {entries.map(({ stop, story },i) => {
      const photos = journal.photos[stop.id];
      const cover = photos[0];
      const startsRegion = stop.region && stop.region !== entries[i-1]?.stop.region;
      const regionCount = entries.filter(entry => entry.stop.region === stop.region).length;
      const StoryHeading = stop.region ? 'h3' : 'h2';
      return <>
      {startsRegion && <h2 class="travel-region-heading">{stop.region}<span>{regionCount} {regionCount === 1 ? 'place' : 'places'}</span></h2>}
      <article class="travel-story" id={cardId(stop.id)} data-travel-story={stop.id} data-place-name={stop.name} tabindex="-1">
        <a class="travel-story-link" href={storyHref(country, stop.id)}>
          <div class="travel-story-photo"><img src={cover.thumbnail} width={cover.width} height={cover.height} alt={cover.alt} loading="lazy" decoding="async"/><span class="travel-photo-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span></div>
          <div class="travel-story-text"><div class="travel-story-meta"><span>{stop.name}</span>{story.data.visited && <time datetime={story.data.visited}>{story.data.dateLabel ?? formatVisitDate(story.data.visited)}</time>}</div><StoryHeading class="travel-story-title">{story.data.title}</StoryHeading><p>{story.data.caption}</p><span class="travel-story-bottom">{cover.placeholder ? 'Photo to come' : `${photos.length} ${photos.length === 1 ? 'photograph' : 'photographs'}`}<span class="travel-open">Open the page <span aria-hidden="true">↗</span></span></span></div>
        </a>
      </article></>;
    })}
  </div>
</section>
