---
const channels = ['red', 'green', 'blue'];
---

<aside class="interests-warning" aria-labelledby="interests-warning-title" data-interests-warning>
  <div class="warning-sheet">
    <div class="warning-reveal">
      <div class="warning-content">
        <p class="warning-eyebrow">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3 22 21H2L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 9v5m0 3v.5" stroke="currentColor" stroke-width="2" />
          </svg>
          Personal territory ahead
        </p>

        <h2 class="warning-title" id="interests-warning-title">
          {channels.map((channel) => (
            <span class={`warning-channel warning-channel-${channel}`} aria-hidden="true">WARNING</span>
          ))}
          <span class="warning-word">WARNING</span>
          <span class="warning-slice" aria-hidden="true">WARNING</span>
        </h2>

        <p class="warning-message">The deeper you scroll,<br />the more you'll know about me.</p>
        <p class="warning-caution">Proceed with caution. <span aria-hidden="true">↓</span></p>
      </div>
    </div>

    <div class="warning-bar warning-bar-top" aria-hidden="true">
      <div class="warning-tape"></div>
    </div>
    <div class="warning-bar warning-bar-bottom" aria-hidden="true">
      <div class="warning-tape warning-tape-bottom"></div>
    </div>
  </div>
</aside>

<script>
  /* SCROLL STORYBOARD — reversible; nothing runs on a timer.
   * Entrance follows a point 20% down the sheet, from 86% to 48% of the viewport.
   *   0–24%  top bar flies in from the left, near the top of the section
   *   4–28%  bottom bar flies in from the right and meets the top bar
   *  30–100% bars separate upward/downward, opening the warning between them
   * After opening: RGB separation, title tears, and tilt build on further scroll.
   */
  const ENTRANCE = {
    pivot: 0.2,           // start near the top instead of reserving half an empty panel
    startAt: 0.86,        // viewport fraction where the bars start entering
    fullOpenAt: 0.48,     // viewport fraction where the warning is fully open
    topLanded: 0.24,      // top bar finishes its horizontal travel
    bottomStart: 0.04,    // slight stagger for the bottom bar
    bottomLanded: 0.28,   // bottom bar finishes its horizontal travel
    openStart: 0.3,       // both bars land before the panel opens
    travel: 110,          // percent of the sheet width; clears both viewport edges
  };
  const GLITCH = {
    steps: 16,             // distinct signal offsets across the section's passage
    split: 12,             // maximum RGB separation in px
    tear: 18,              // maximum title-slice offset in px
    tilt: 2.4,             // maximum sheet tilt in degrees
    skew: 1.2,             // maximum title skew in degrees
    tapeTravel: 48,        // hazard-stripe travel in px
  };

  const clamp = (value: number) => Math.max(0, Math.min(1, value));
  const range = (value: number, start: number, end: number) => clamp((value - start) / (end - start));
  const easeOut = (value: number) => 1 - (1 - value) ** 3;
  const smoothstep = (value: number) => value * value * (3 - 2 * value);

  const warning = document.querySelector<HTMLElement>('[data-interests-warning]');
  const sheet = warning?.querySelector<HTMLElement>('.warning-sheet');

  if (warning && sheet) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0;
    let visible = false;

    const update = () => {
      raf = 0;
      if (reducedMotion.matches) return;

      // Measure the stationary wrapper, so the animated sheet never feeds
      // its own rotation back into the scroll-progress calculation.
      const rect = warning.getBoundingClientRect();
      const vh = window.innerHeight;
      // Use layout height so the later tilt cannot change the entrance timing.
      const anchorOffset = rect.height / 2 - sheet.offsetHeight * (0.5 - ENTRANCE.pivot);
      const anchor = rect.top + anchorOffset;
      const entrance = range(vh * ENTRANCE.startAt - anchor, 0, vh * (ENTRANCE.startAt - ENTRANCE.fullOpenAt));
      const top = easeOut(range(entrance, 0, ENTRANCE.topLanded));
      const bottom = easeOut(range(entrance, ENTRANCE.bottomStart, ENTRANCE.bottomLanded));
      const open = smoothstep(range(entrance, ENTRANCE.openStart, 1));
      // Distortion starts only after the warning is fully open.
      const progress = range(vh * ENTRANCE.fullOpenAt - anchor, 0, vh * ENTRANCE.fullOpenAt + rect.height - anchorOffset);
      const intensity = progress * progress;
      const step = Math.floor(progress * GLITCH.steps);
      const signal = Math.sin(step * 2.4);
      const split = intensity * GLITCH.split;

      warning.style.setProperty('--warning-top-x', `${(top - 1) * ENTRANCE.travel}%`);
      warning.style.setProperty('--warning-bottom-x', `${(1 - bottom) * ENTRANCE.travel}%`);
      warning.style.setProperty('--warning-pivot', `${ENTRANCE.pivot * 100}%`);
      warning.style.setProperty('--warning-closed', `${1 - open}`);
      warning.style.setProperty('--warning-mask-top', `${(1 - open) * ENTRANCE.pivot * 100}%`);
      warning.style.setProperty('--warning-mask-bottom', `${(1 - open) * (1 - ENTRANCE.pivot) * 100}%`);
      warning.style.setProperty('--warning-content-opacity', `${range(open, 0.08, 0.65)}`);
      warning.style.setProperty('--warning-tilt', `${intensity * (GLITCH.tilt + signal * 0.3)}deg`);
      warning.style.setProperty('--warning-skew', `${signal * intensity * GLITCH.skew}deg`);
      warning.style.setProperty('--warning-split', `${split}px`);
      warning.style.setProperty('--warning-tear', `${signal * intensity * GLITCH.tear}px`);
      warning.style.setProperty('--warning-rgb-opacity', `${Math.min(0.85, progress * 1.2)}`);
      warning.style.setProperty('--warning-tape-x', `${progress * GLITCH.tapeTravel}px`);
    };

    const schedule = () => {
      if (!raf && visible && !reducedMotion.matches) raf = requestAnimationFrame(update);
    };

    const syncMotion = () => {
      if (reducedMotion.matches) {
        cancelAnimationFrame(raf);
        raf = 0;
        warning.removeAttribute('style');
        window.removeEventListener('scroll', schedule);
      } else {
        window.addEventListener('scroll', schedule, { passive: true });
        // Set the initial pose before intersection/scroll callbacks, including
        // when reloading directly into the middle of the warning.
        update();
      }
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      schedule();
    }, { rootMargin: '80px 0px' }).observe(warning);

    // Region windows above the warning expand as the rail reaches them.
    // Their layout shifts must update progress even when scrolling stops.
    new ResizeObserver(schedule).observe(warning.closest('[data-journey]') ?? warning);
    window.addEventListener('resize', schedule);
    document.fonts.ready.then(schedule);
    reducedMotion.addEventListener('change', syncMotion);
    syncMotion();
  }
</script>

<style>
  .interests-warning {
    --warning-red: #c92332;
    --warning-white: #fff9f2;
    --warning-tilt: 0deg;
    --warning-skew: 0deg;
    --warning-split: 0px;
    --warning-tear: 0px;
    --warning-rgb-opacity: 0;
    --warning-tape-x: 0px;
    --warning-bar-height: 12px;
    /* Fully open without JavaScript or with reduced motion. */
    --warning-top-x: 0%;
    --warning-bottom-x: 0%;
    --warning-closed: 0;
    --warning-pivot: 20%;
    --warning-mask-top: 0%;
    --warning-mask-bottom: 0%;
    --warning-content-opacity: 1;
    position: relative;
    z-index: 2;
    isolation: isolate;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: 32px;
    padding-block: 32px;
    overflow: clip;
    color: var(--warning-white);
  }

  .warning-sheet {
    position: relative;
    width: calc(100% + 96px);
    margin-inline: -48px;
    transform: rotate(var(--warning-tilt));
    transform-origin: center;
  }

  .warning-reveal {
    padding-block: var(--warning-bar-height);
    background: var(--warning-red);
    clip-path: inset(var(--warning-mask-top) 0 var(--warning-mask-bottom));
  }

  /* Full-height bar layers make percentage translations relative to the
     stationary sheet. They meet near its top without changing layout. */
  .warning-bar {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .warning-bar-top {
    transform: translate3d(
      var(--warning-top-x),
      calc(var(--warning-closed) * (var(--warning-pivot) - var(--warning-bar-height))),
      0
    );
  }

  .warning-bar-bottom {
    transform: translate3d(
      var(--warning-bottom-x),
      calc(var(--warning-closed) * (var(--warning-pivot) - 100% + var(--warning-bar-height))),
      0
    );
  }

  .warning-tape {
    position: absolute;
    top: 0;
    inset-inline: -64px;
    height: var(--warning-bar-height);
    background: repeating-linear-gradient(
      -45deg,
      var(--warning-white) 0 12px,
      var(--warning-red) 12px 24px
    );
    transform: translateX(var(--warning-tape-x));
  }

  .warning-tape-bottom {
    top: auto;
    bottom: 0;
    transform: translateX(calc(-1 * var(--warning-tape-x)));
  }

  .warning-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(40px, 5vw, 64px) 72px;
    text-align: center;
    opacity: var(--warning-content-opacity);
  }

  .warning-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .warning-eyebrow svg {
    width: 21px;
    height: 21px;
    flex: none;
  }

  .warning-title {
    position: relative;
    isolation: isolate;
    margin-block: 20px 24px;
    font-family: var(--font-serif);
    font-size: clamp(3.75rem, 13.5vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    white-space: nowrap;
    transform: skewX(var(--warning-skew));
  }

  .warning-word {
    position: relative;
    z-index: 1;
  }

  .warning-channel,
  .warning-slice {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }

  .warning-channel {
    opacity: var(--warning-rgb-opacity);
    mix-blend-mode: screen;
  }

  .warning-channel-red {
    color: #ff3434;
    transform: translate(calc(-1 * var(--warning-split)), calc(var(--warning-split) * 0.2));
  }

  .warning-channel-green {
    color: #3cff83;
    transform: translate(var(--warning-split), calc(var(--warning-split) * -0.15));
  }

  .warning-channel-blue {
    color: #4263ff;
    transform: translate(calc(var(--warning-split) * 0.4), calc(var(--warning-split) * 0.35));
  }

  .warning-slice {
    z-index: 2;
    clip-path: polygon(0 32%, 100% 32%, 100% 42%, 0 42%, 0 68%, 100% 68%, 100% 73%, 0 73%);
    transform: translateX(var(--warning-tear));
    opacity: var(--warning-rgb-opacity);
  }

  .warning-message {
    font-size: clamp(1.125rem, 1rem + 0.75vw, 1.5rem);
    line-height: 1.5;
    text-wrap: balance;
  }

  .warning-caution {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    font-family: var(--font-label);
    font-size: 14px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .warning-caution span {
    font-size: 22px;
    line-height: 1;
  }

  @media (max-width: 480px) {
    .warning-content {
      padding-inline: 64px;
    }
    .warning-eyebrow {
      font-size: 9px;
      letter-spacing: 0.12em;
    }
    .warning-title {
      margin-block: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .warning-sheet,
    .warning-bar,
    .warning-title,
    .warning-tape {
      transform: none;
    }
    .warning-reveal {
      clip-path: none;
    }
    .warning-content {
      opacity: 1;
    }
    .warning-channel,
    .warning-slice {
      display: none;
    }
  }
</style>
