---
import TravelMapFrame from './TravelMapFrame.astro';
import type { JournalCountry, TravelStop, TravelMapCluster } from '../data/travel-journals';
interface Props {
  country: JournalCountry;
  prefix: string;
  stops: readonly TravelStop[];
  linked?: boolean;
  bounds: Record<string, string>;
  base: readonly [number, number, number, number];
  outline?: string;
  markerScale?: number;
  clusters?: readonly TravelMapCluster[];
}
const { country, prefix, stops, linked = false, bounds, base, outline, markerScale = .32, clusters = [] } = Astro.props;
const symbols = [...new Set([...stops.map(stop => stop.symbol), ...clusters.map(cluster => cluster.symbol)])];
const assetRoot = `/images/travel/${country}-map`;
---
<TravelMapFrame country={country} prefix={prefix} stops={stops} linked={linked} markerScale={markerScale} clusters={clusters} markersOnly followOnMobile>
  <defs>
    {outline && <>
      <path id={`${prefix}-country-outline`} d={outline} fill-rule="evenodd" clip-rule="evenodd" />
      <clipPath id={`${prefix}-painted-outline`}><use href={`#${prefix}-country-outline`} /></clipPath>
    </>}
    {clusters.length > 0 && <filter id={`${prefix}-cluster-outline`} x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
      <feMorphology in="SourceAlpha" operator="dilate" radius=".7" result="border" />
      <feFlood flood-color="#b7392d" />
      <feComposite in2="border" operator="in" />
      <feMerge><feMergeNode /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>}
    <filter id={`${prefix}-marker-outline`} x="-35%" y="-35%" width="170%" height="170%" color-interpolation-filters="sRGB">
      <feMorphology in="SourceAlpha" operator="dilate" radius="2.5" result="border" />
      <feFlood flood-color="#b7392d" />
      <feComposite in2="border" operator="in" />
      <feMerge><feMergeNode /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    {symbols.map(symbol => <g id={`${prefix}-${symbol}`}>
      <svg x="-55" y="-90" width="110" height="95" viewBox={bounds[symbol]} preserveAspectRatio="xMidYMax meet" aria-hidden="true">
        <image href={`${assetRoot}/${symbol}.webp`} width="256" height="256" />
      </svg>
    </g>)}
  </defs>
  <g class="painted-map-base" aria-hidden="true">
    {outline && <use href={`#${prefix}-country-outline`} fill="#a7b58b" />}
    <image href={`${assetRoot}/base.webp`} x={base[0]} y={base[1]} width={base[2]} height={base[3]} preserveAspectRatio="none" clip-path={outline ? `url(#${prefix}-painted-outline)` : undefined} />
  </g>
  {clusters.map(cluster => <image class="map-city-geography" data-map-detail={cluster.id} data-detail-src={cluster.detail.src} x={cluster.detail.bounds[0]} y={cluster.detail.bounds[1]} width={cluster.detail.bounds[2]} height={cluster.detail.bounds[3]} preserveAspectRatio="none" aria-hidden="true" />)}
</TravelMapFrame>
