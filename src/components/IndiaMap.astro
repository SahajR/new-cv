---
import TravelMapFrame from './TravelMapFrame.astro';
import { indiaOutline } from '../data/india-outline';
import type { TravelStop } from '../data/travel-journals';
interface Props { stops: readonly TravelStop[]; linked?: boolean }
const { stops, linked = false } = Astro.props;
