---
import PaintedTravelMap from './PaintedTravelMap.astro';
import paintedBounds from '../data/india-map-art.json';
import { indiaClusters } from '../data/india';
import { indiaOutline } from '../data/india-outline';
import type { TravelStop } from '../data/travel-journals';
interface Props { stops: readonly TravelStop[]; linked?: boolean }
const { stops, linked = false } = Astro.props;
---
<PaintedTravelMap country="india" prefix="in" stops={stops} linked={linked} bounds={paintedBounds} base={[14.51, 4.91, 315.04, 346.02]} outline={indiaOutline} markerScale={.23} clusters={indiaClusters} />
