---
/**
 * Hero visual slot. The reference has an interactive plane window here;
 * this is a framed placeholder with the same footprint (200×300) so the
 * layout is right while the real visual is designed. Drop a React island
 * or an <img> into the slot to replace it.
 */
---

<div class="folio-window reveal">
  <div class="window-frame">
    <slot>
      <div class="window-placeholder" aria-hidden="true">
        <span class="wp-mark">SR</span>
      </div>
    </slot>
  </div>
</div>

<style>
  .folio-window {
    position: relative;
    z-index: 6;
    --reveal-delay: 0ms;
  }
  .window-frame {
    position: relative;
    width: 200px;
    height: 300px;
    margin: 0 auto;
    isolation: isolate;
    user-select: none;
  }
  .window-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 100px;
    background: linear-gradient(160deg, var(--placeholder-a), var(--placeholder-b));
    box-shadow:
      inset 0 0 0 1px var(--keyline),
      0 1px 2px rgba(var(--shadow-rgb), 0.06),
      0 12px 32px rgba(var(--shadow-rgb), 0.08);
  }
  .wp-mark {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 56px;
    letter-spacing: 2px;
    color: var(--mute);
  }
</style>
