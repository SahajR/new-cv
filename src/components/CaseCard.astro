---
import type { CaseStudy } from '../data/profile';

interface Props {
  item: CaseStudy;
}

const { item } = Astro.props;
const shots = [0, 1, 2].map((i) => item.shots?.[i]);
---

<li class="tl-case">
  <a class="case" href={item.href}>
    <span class="tl-dot tl-dot-case" aria-hidden="true"></span>
    <span class="case-shots" aria-hidden="true">
      {shots.map((src) => (
        <span class="cs-shot">{src && <img src={src} alt="" draggable="false" />}</span>
      ))}
    </span>
    <span class="case-text">
      <span class="case-title">{item.title}</span>
      <span class="case-desc">{item.desc}</span>
    </span>
  </a>
</li>

<style>
  .tl-case {
    list-style: none;
  }
  .case {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 2px 15px;
    border-radius: 16px;
    text-decoration: none;
    background: transparent;
    transition: background-color 0.26s var(--ease-out);
  }
  .case:hover {
    background: var(--surface-hover);
  }
  .case-shots {
    position: relative;
    width: 66px;
    height: 63px;
    flex-shrink: 0;
  }
  .cs-shot {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1.5px solid var(--keyline);
    border-radius: 2.5px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--placeholder-a), var(--placeholder-b));
    box-shadow:
      0 0.85px 5px rgba(var(--shadow-rgb), 0.1),
      0 0.43px 1.3px rgba(var(--shadow-rgb), 0.06);
    transform: translate(-50%, -50%) translate(var(--x), var(--y)) rotate(var(--r)) scale(var(--s, 1));
    transition: transform 0.38s var(--ease-in);
  }
  .cs-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-shot:nth-child(1) { width: 25.7px; height: 34.1px; z-index: 1; --x: -13.7px; --y: -0.8px; --r: -9.94deg; }
  .cs-shot:nth-child(2) { width: 35px;   height: 46.3px; z-index: 3; --x: -1.6px;  --y: -0.7px; --r: 0deg; }
  .cs-shot:nth-child(3) { width: 30px;   height: 39.7px; z-index: 2; --x: 11.3px;  --y: 0.5px;  --r: 7.21deg; }
  .case:hover .cs-shot:nth-child(1) { --x: -18px;  --y: -3px; --r: -15deg; }
  .case:hover .cs-shot:nth-child(2) { --y: -3px;  --s: 1.03; }
  .case:hover .cs-shot:nth-child(3) { --x: 15.5px; --y: -2px; --r: 12deg; }

  .case-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1 0 0;
    min-width: 0;
  }
  .case-title {
    font-weight: 500;
    font-size: 14px;
    line-height: 17.5px;
    color: var(--ink-title);
  }
  .case-desc {
    font-size: 13px;
    line-height: 21px;
    color: var(--ink-desc);
  }
  @media (max-width: 620px) {
    .case {
      padding-left: 8px;
      padding-right: 8px;
    }
  }
</style>
