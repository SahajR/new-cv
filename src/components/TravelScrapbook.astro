---
import { travelCountries, countryHref, BOOK_VISIT_KEY, BOOK_HANDOFF_KEY } from '../data/travel';
import ScrapbookNote from './ScrapbookNote.astro';
import JapanMap from './JapanMap.astro';
import { getJapanStories } from '../lib/travel-content';
import '../styles/scrapbook.css';
interface Props { page?: number; mode?: 'embedded' | 'journal' | 'index' }
const { page = 1, mode = 'embedded' } = Astro.props;
const country = travelCountries[page - 1];
const japanEntries = await getJapanStories();
// Sparse, asymmetric flecks: paper dust, rather than a confetti burst.
const dust = Array.from({ length: 14 }, (_, i) => ({
  x: i % 2 ? 75 + (i % 3) * 2 : 25 - (i % 3) * 2,
  y: 77 + (i * 5) % 13,
  dx: (i % 2 ? 1 : -1) * (6 + (i * 3) % 12),
  dy: -(3 + (i * 7) % 12),
  size: 2 + i % 4,
  lag: (i * 13) % 80,
}));
---

<section class="scrapbook" data-scrapbook data-mode={mode} data-position={page} data-target={page} data-open={String(page > 0)} style={`--position: ${page}; --leaf-count: ${travelCountries.length + 1}`} aria-label="Travel scrapbook">
  {mode === 'embedded' && <div class="sb-topline"><span>Sahaj’s travel journal</span><span aria-hidden="true">EST. IN CURIOSITY</span></div>}
  <div class="sb-stage" data-book-stage>
    <div class="sb-landing-shadow" aria-hidden="true"></div>
    <div class="sb-arrival" data-book-arrival>
      <div class="sb-volume" data-book-volume>
        <div class="sb-board sb-board-right" aria-hidden="true"></div>
        <div class="sb-leaf sb-cover" data-leaf="0" style="--leaf: 0">
          <div class="sb-cover-board" aria-hidden="true"></div>
          {['fore', 'top', 'bottom'].map(side => <div class={`sb-leaf-edge sb-leaf-edge-${side}`} aria-hidden="true"></div>)}
          <div class="sb-face sb-front sb-cover-art" data-face-page="0" aria-hidden={page !== 0 ? 'true' : undefined} inert={page !== 0}>
            <img src="/images/travel/scrapbook-cover.webp" width="1200" height="778" alt="Our Adventure Book — a worn leather scrapbook with a red cloth binding" loading={mode === 'embedded' ? 'lazy' : 'eager'} />
            {mode === 'embedded' && <button type="button" class="sb-open" data-book-open aria-label="Open travel scrapbook"><span>Open the book <span aria-hidden="true">↗</span></span></button>}
          </div>
          <div class="sb-face sb-back" data-face-page="1" aria-hidden={page !== 1 ? 'true' : undefined} inert={page !== 1}>
            <ScrapbookNote country={travelCountries[0]} journal={mode === 'journal'} />
          </div>
        </div>
        {travelCountries.map((entry, i) => (
          <div class="sb-leaf" data-leaf={entry.page} style={`--leaf: ${entry.page}`}>
            {['fore', 'top', 'bottom'].map(side => <div class={`sb-leaf-edge sb-leaf-edge-${side}`} aria-hidden="true"></div>)}
            <div class="sb-face sb-front" data-face-page={entry.page} aria-hidden={page !== entry.page ? 'true' : undefined} inert={page !== entry.page}>
              {entry.slug === 'japan' ? <div class="sb-map-page" data-book-map-slot>
                <JapanMap stops={japanEntries.map(entry => entry.stop)} linked={mode !== 'journal'} />
              </div> : <figure class="sb-postcard">
                <img src={entry.image} alt={entry.imageAlt} width="40" height="60" loading={mode === 'journal' ? 'eager' : 'lazy'} />
                <figcaption>{entry.caption}</figcaption>
              </figure>}
              <span class="sb-postmark" aria-hidden="true">{entry.code} / {String(entry.page).padStart(2, '0')}</span>
            </div>
            <div class="sb-face sb-back" data-face-page={entry.page + 1} aria-hidden={page !== entry.page + 1 ? 'true' : undefined} inert={page !== entry.page + 1}>
              {travelCountries[i + 1] ? <ScrapbookNote country={travelCountries[i + 1]} journal={mode === 'journal'} /> : <p class="sb-endpaper">More of the world<br />is still out there.</p>}
            </div>
          </div>
        ))}
        <svg class="sb-cord" viewBox="0 0 30 200" aria-hidden="true" fill="none">
          <g stroke="#322318" stroke-width="3" stroke-linecap="round">
            <path d="M15 35C-9 4 2 0 9 15L18 74C35 140-4 123 12 75C28 43 29 26 15 35ZM14 36L20 190M15 36L4 176" />
          </g>
          <path d="M15 35C-9 4 2 0 9 15L18 74C35 140-4 123 12 75C28 43 29 26 15 35ZM14 36L20 190M15 36L4 176" stroke="#79604a" stroke-width=".6" />
        </svg>
      </div>
    </div>
    <div class="sb-dust" aria-hidden="true">
      {dust.map((fleck) => <span style={`--x:${fleck.x}%;--y:${fleck.y}%;--dx:${fleck.dx}cqw;--dy:${fleck.dy}cqw;--size:${fleck.size}px;--lag:${fleck.lag}ms;`} />)}
    </div>
  </div>
  <div class="sb-controls" hidden={mode === 'index'}>
    <button type="button" data-book-previous aria-label="Previous scrapbook page" disabled={page <= 1}>←</button>
    <p class="sb-counter" data-book-status role="status" aria-live="polite" aria-atomic="true">{country?.name ?? 'An adventure awaits'} <span>{country && ` / ${String(page).padStart(2, '0')}—05`}</span></p>
    <button type="button" data-book-next aria-label="Next scrapbook page" disabled={page === travelCountries.length}>→</button>
  </div>
  {mode === 'index' && <h2 class="sb-contents-title" id="book-contents">Contents</h2>}
  {mode === 'index' && <nav class="sb-destinations sb-contents" aria-label="Scrapbook countries">
    {travelCountries.map((entry) => (
      <a href={countryHref(entry)} data-book-country={entry.slug} data-page={entry.page} aria-current={entry.page === page ? 'page' : undefined}><span>{String(entry.page).padStart(2, '0')}</span>{entry.name}<span class="sb-contents-arrow" aria-hidden="true">↗</span></a>
    ))}
  </nav>}
  {mode === 'embedded' && <a class="sb-read" data-book-read href="/travel/">Explore the travel journal <span aria-hidden="true">↗</span></a>}
</section>
<script is:inline define:vars={{ visitKey: BOOK_VISIT_KEY, transferKey: BOOK_HANDOFF_KEY }}>
  {
    const root = document.currentScript.previousElementSibling;
    const target = Number(root.dataset.target);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let position = reduced ? target : 0;
    let restored = false;
    try {
      const handoff = JSON.parse(sessionStorage.getItem(transferKey) || 'null');
      const bookmark = Number(sessionStorage.getItem(visitKey));
      const valid = (n) => Number.isInteger(n) && n >= 0 && n <= 5;
      const reloading = performance.getEntriesByType('navigation')[0]?.type === 'reload';
      if (!reloading && handoff && handoff.path === location.pathname.replace(/\/$/, '') && Date.now() - handoff.time < 15000 && valid(handoff.page)) {
        position = handoff.page;
        restored = true;
        root.dataset.handoff = 'true';
        if (root.dataset.mode === 'embedded') root.dataset.target = String(position);
      } else if (root.dataset.mode === 'embedded' && valid(bookmark) && bookmark > 0) {
        position = bookmark;
        root.dataset.target = String(bookmark);
      }
      sessionStorage.removeItem(transferKey);
    } catch { /* Keep the book usable when storage is unavailable. */ }
    root.dataset.position = String(position);
    root.dataset.arrival = position === 0 && !reduced && !restored ? 'waiting' : 'complete';
    root.dataset.open = String(position > 0);
    root.style.setProperty('--position', position);
    root.querySelectorAll('[data-face-page]').forEach(face => {
      const visible = Number(face.dataset.facePage) === position;
      face.inert = !visible;
      face.setAttribute('aria-hidden', String(!visible));
    });
    root.dataset.boot = 'true';
  }
</script>
<script>
  import { setupScrapbook } from '../scripts/scrapbook';
  document.querySelectorAll<HTMLElement>('[data-scrapbook]').forEach(setupScrapbook);
</script>
