---
const places = [
  {
    image: '/images/travel/petra.png',
    alt: 'Pixel art of Al-Khazneh, Petra’s Treasury in Jordan, its rose-sandstone columns framed by the canyon.',
  },
  {
    image: '/images/travel/pyramids.png',
    alt: 'Pixel art of the pyramids of Giza in Egypt, with sunlit faces and deep shadows across the desert.',
  },
  {
    image: '/images/travel/taj-mahal.png',
    alt: 'Pixel art of the Taj Mahal in India, its pale dome and minarets reflected in the garden pool.',
  },
  {
    image: '/images/travel/japan.png',
    alt: 'Pixel art of snow-capped Mount Fuji behind the red Chureito pagoda and cherry blossoms in Japan.',
  },
];
---

<div class="travel-banner" role="group" aria-label="Travel landmarks">
  <div class="travel-tiles">
    {places.map((place) => (
      <figure class="travel-tile">
        <img
          src={place.image}
          alt={place.alt}
          width="40"
          height="60"
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))}
  </div>
</div>

<style>
  .travel-banner {
    width: 100%;
    min-width: 0;
    margin-top: 8px;
    container-type: inline-size;
  }
  .travel-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(4px, 1.4cqi, 8px);
  }
  .travel-tile {
    min-width: 0;
    margin: 0;
  }
  .travel-tile img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    image-rendering: pixelated;
    background: #242136;
  }
</style>
