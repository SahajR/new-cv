  <g aria-hidden="true">
    <use href="#eg-land" transform="translate(0 7)" fill="#bda16d" stroke="#bda16d" stroke-width="5"/>
    <use href="#eg-land" fill="#dec995" stroke="#f0e1b8" stroke-width="9"/>
    <use href="#eg-land" fill="#dec995" stroke="#bea16d" stroke-width="1.5"/>
    <g clip-path="url(#eg-land-clip)">
      <path d="M367 89H462L480 140L458 218L429 251L368 239Z M574 148L600 204L644 303H607L569 233L560 180Z" fill="#d3ba83"/>
      <path d="M492 50L513 44L530 54L524 73L514 92L504 72Z" fill="#a8b780"/>
      <path d="M552 305L543 281L539 246L551 222L549 204L558 187L540 169L530 152L526 127L514 88" fill="none" stroke="#a4b27d" stroke-width="15" stroke-linejoin="round"/>
