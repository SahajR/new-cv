    <g id="eg-palm"><path d="M0 0L2-23" stroke="#99734b" stroke-width="4"/><path d="M2-23Q-15-40-22-22Q-9-29 2-23Q-12-23-14-9Q-6-19 2-23Q11-39 23-24Q10-28 2-23Q17-25 20-10Q11-21 2-23" fill="#7c9564"/></g>
