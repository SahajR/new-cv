---
import PaintedTravelMap from './PaintedTravelMap.astro';
import paintedBounds from '../data/egypt-map-art.json';
import type { TravelStop } from '../data/travel-journals';
interface Props { stops: readonly TravelStop[]; linked?: boolean }
const { stops, linked = false } = Astro.props;
---
<PaintedTravelMap country="egypt" prefix="eg" stops={stops} linked={linked} bounds={paintedBounds} base={[335, 5, 330, 330]} markerScale={.23} />
