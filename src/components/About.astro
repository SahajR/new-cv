---
import { about } from '../data/profile';
---

<div class="about" id="about">
  {about.paragraphs.map((p) => <p class="about-p">{p}</p>)}

  <p class="about-p about-focus-intro">{about.focusIntro}</p>
  <ul class="about-focus">
    {about.focus.map((item) => <li>{item}</li>)}
  </ul>

  <hr class="about-rule" />

  <p class="about-closing">{about.closing}</p>
</div>

<style>
  .about {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .about-p {
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.1875rem);
    line-height: 1.65;
    letter-spacing: -0.005em;
    color: var(--body);
  }
  .about-focus-intro {
    margin-top: 0.4rem;
    color: var(--ink);
  }
  .about-focus {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1.4rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.1875rem);
    line-height: 1.6;
    color: var(--body);
  }
  .about-focus li {
    position: relative;
  }
  .about-focus li::before {
    content: '';
    position: absolute;
    left: -1.4rem;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .about-rule {
    width: 48px;
    height: 1px;
    margin: 1.6rem auto;
    border: 0;
    background-image: radial-gradient(circle at 1px 1px, var(--rule) 1px, transparent 1.2px);
    background-size: 5px 1px;
    background-color: transparent;
  }
  .about-closing {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    line-height: 1.4;
    letter-spacing: 0.005em;
    text-align: center;
    color: var(--ink);
    text-wrap: balance;
  }
</style>
