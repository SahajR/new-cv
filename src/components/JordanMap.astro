---
import TravelMapFrame from './TravelMapFrame.astro';
import { jordanOutline } from '../data/jordan-outline';
import type { TravelStop } from '../data/travel-journals';
interface Props { stops: readonly TravelStop[]; linked?: boolean }
const { stops, linked = false } = Astro.props;
---
<TravelMapFrame country="jordan" prefix="jo" stops={stops} linked={linked}>
  <defs>
    <path id="jo-land" d={jordanOutline} />
    <clipPath id="jo-land-clip"><use href="#jo-land" /></clipPath>
    <g id="jo-palm"><path d="M0 0L3-28" stroke="#966949" stroke-width="5"/><path d="M3-28Q-16-45-25-28Q-9-34 3-28Q-13-27-17-12Q-6-22 3-28Q12-43 26-30Q11-34 3-28Q19-29 24-12Q13-24 3-28" fill="#748567"/></g>
    <g id="jo-rock"><path d="M-20 4L-16-13H-8V-26H4V-19H13L19 4Z" fill="#b8815b"/><path d="M4-26V-19H13L19 4H4Z" fill="#95694e"/><path d="M-14-9H0M-12 0H2" stroke="#d2a57a" stroke-width="2"/></g>
    <g id="jo-citadel">
      <path d="M-42 1H40V-7H-42Z M-36-7H34V-14H-36Z" fill="#ba9c6e"/>
      <path d="M-26-14V-70H-14V-14M5-14V-70H17V-14M27-14V-42H37V-14" fill="#ebd7a7"/>
      <path d="M-30-70H-10V-77H-30Z M1-70H21V-77H1Z M23-42H41V-48H23Z" fill="#cfb486"/>
      <path d="M-33-77H24V-85H-33Z" fill="#e4c898"/>
      <path d="M-22-64V-19M9-64V-19M30-36V-18" stroke="#c3a47b" stroke-width="3"/>
      <path d="M-10-2L-5-20H5L8-2" fill="#9c805f"/>
    </g>
    <g id="jo-treasury">
      <path d="M-44 2V-87L-30-95H31L43-82V2Z" fill="#c38463"/>
      <path d="M-35-5V-47H34V-5Z" fill="#dfa981"/>
      <path d="M-40-48L-27-61H27L40-48Z M-34-67L-19-83H19L34-67Z" fill="#e7b48c"/>
      <path d="M-38-45H38M-33-64H33M-38-4H38" stroke="#9b604b" stroke-width="5"/>
      <path d="M-29-41V-9M-17-41V-9M17-41V-9M29-41V-9M-24-61V-72M24-61V-72" stroke="#f1c59c" stroke-width="6"/>
      <path d="M-8-5V-34Q0-43 8-34V-5" fill="#775241"/>
      <path d="M-9-63V-80Q0-90 9-80V-63Z" fill="#c18a65"/>
      <path d="M-10-84L0-94L10-84Z M-4-96H4V-102H-4Z" fill="#edba8c"/>
      <path d="M-43 3H43V9H-43Z" fill="#b57b59"/>
    </g>
    <g id="jo-camp">
      <use href="#jo-rock" transform="translate(-31 -12) scale(1.45)"/>
      <use href="#jo-rock" transform="translate(24 -17) scale(1.8)"/>
      <path d="M-45 3H47L35-5H-31Z" fill="#c48659"/>
      <path d="M-23 0A35 38 0 0 1 13-30A34 38 0 0 1 48 0Z" fill="#eee1c8"/>
      <path d="M10-28V0M-15-13H39M-9-24L2 0M31-24L20 0" stroke="#b7a78c" stroke-width="2"/>
      <path d="M9 0V-13Q17-23 25-13V0Z" fill="#805e47"/>
    </g>
    <g id="jo-waterfront">
      <path d="M-44-4H41V7H-44Z" fill="#87b6b5"/>
      <path d="M-39-4H37V-10H-39Z" fill="#dcc79e"/>
      <use href="#jo-palm" transform="translate(-23 -10) scale(1.65)"/>
      <path d="M9-13V-48H35V-13Z" fill="#d4ac7e"/>
      <path d="M5-49L22-61L40-49Z" fill="#8d6850"/>
      <path d="M18-13V-29Q23-37 28-29V-13" fill="#7d6250"/>
      <path d="M-35 2q8 5 16 0q8 5 16 0M5 3q8 5 16 0" stroke="#d3e6d6" stroke-width="2" fill="none"/>
    </g>
    <g id="jo-sea">
      <path d="M-44 0L-32-16H34L46 0L31 12H-29Z" fill="#b9d6d0"/>
      <path d="M-37-2L-25-13H27L37-2L26 7H-23Z" fill="#72a9af"/>
      <path d="M-38 3L-27 10H24L35 5" stroke="#f7f0d6" stroke-width="5" fill="none"/>
      <path d="M-14-11L-5-6L9-8L17-16" fill="none" stroke="#a77859" stroke-width="6" stroke-linecap="round"/>
      <circle cx="-20" cy="-15" r="6" fill="#a77859"/>
      <path d="M-5-2q7 4 14 0M-26 1q5 3 10 0" stroke="#d9e9de" stroke-width="2" fill="none"/>
      <path d="M27-13V-42M8-43Q27-66 46-43Z" fill="#cf9d72" stroke="#8b7556" stroke-width="2"/>
    </g>
  </defs>
  <g aria-hidden="true">
    <use href="#jo-land" transform="translate(0 7)" fill="#ae8961" stroke="#ae8961" stroke-width="5"/>
    <use href="#jo-land" fill="#dec798" stroke="#f0dfb6" stroke-width="9"/>
    <use href="#jo-land" fill="#dec798" stroke="#bc9c70" stroke-width="1.5"/>
    <g clip-path="url(#jo-land-clip)">
      <path d="M400 60L456 46L472 93L450 166L419 209L398 278L383 294L394 234L401 167L393 111Z" fill="#c6bb86"/>
      <path d="M419 195L458 180L510 206L480 247L435 268L428 300L375 298L395 240Z" fill="#ceab7e"/>
      <path d="M538 49h33m-16 10h36m9 30h27m-29 9h43M463 165h25m-16 10h32M431 251h30m-16 9h38" stroke="#c8ac79" stroke-width="3" fill="none"/>
      <use href="#jo-rock" transform="translate(423 207) scale(.45)"/><use href="#jo-rock" transform="translate(409 263) scale(.45)"/><use href="#jo-rock" transform="translate(432 274) scale(.6)"/>
      <use href="#jo-palm" transform="translate(442 141) scale(.45)"/><use href="#jo-palm" transform="translate(422 168) scale(.4)"/>
    </g>
    <path d="M398 132H410V140H406V158H400V166H394V155H390V140H394Z" fill="#87b6b5" stroke="#d2e0c6" stroke-width="2"/>
    <path d="M355 289H367V304H363V318H352V327H337V320H344V305H350Z" fill="#93bdbc"/>
    <g fill="none" stroke="#bec9b1" stroke-width="2"><path d="M332 302q5 6 10 0M334 320q5 6 10 0M382 146q4 5 8 0"/></g>
    <g transform="translate(715 240)" class="map-compass"><path d="M0-22L-7 0H7Z" fill="#8e795c"/><path d="M0 22L-7 0H7Z" fill="#dcd1b7"/><text y="-31" text-anchor="middle">N</text></g>
  </g>
</TravelMapFrame>
