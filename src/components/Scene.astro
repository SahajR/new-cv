---
/**
 * A layer of photographic objects scattered around a section's content.
 *
 * Usage: place inside a `position: relative` section; the layer stretches to
 * cover it. Objects are described as data (see src/data/scene.ts) so adding
 * more to a section is a data change, not a markup change.
 *
 * Parallax: a single scroll listener updates one CSS var (--py) per object,
 * scaled by its `depth`, relative to how far the section is from the centre
 * of the viewport. Transforms only — no layout work on scroll.
 */
import type { SceneObject } from '../data/scene';

interface Props {
  objects: SceneObject[];
  /** Extra class on the layer, if a section needs to tweak it. */
  class?: string;
  /** Spring the objects in from outside the viewport after the intro. */
  entrance?: boolean;
}

const { objects, class: className, entrance = false } = Astro.props;

// Vertical anchors: fractions become percentages of the section; strings pass through.
const yVal = (y: number | string) => (typeof y === 'number' ? `${y * 100}%` : y);

const styleFor = (o: SceneObject) => {
  const m = o.mobile ?? {};
  const vars: Record<string, string | number> = {
    '--x': o.x,
    '--y': yVal(o.y),
    '--w': o.width,
    '--r': `${o.rotate ?? 0}deg`,
    '--ty': o.anchor === 'top' ? '0%' : '-50%',
    '--depth': o.depth ?? 0,
    '--z': o.z ?? 1,
    '--xm': m.x ?? o.x,
    '--ym': yVal(m.y ?? o.y),
    '--wm': m.width ?? o.width,
    '--rm': `${m.rotate ?? o.rotate ?? 0}deg`,
  };
  return Object.entries(vars)
    .map(([k, v]) => `${k}: ${v}`)
    .join('; ');
};
---

<div class:list={['scene', className]} aria-hidden="true" data-scene data-scene-entrance={entrance ? 'complete' : undefined}>
  {objects.map((o) => (
    <div
      class:list={['scene-obj', { 'is-mobile-hidden': o.mobile?.hidden }]}
      style={styleFor(o)}
      data-id={o.id}
    >
      <div class="scene-flight">
        <img
          src={o.src}
          width={o.w}
          height={o.h}
          alt={o.alt}
          draggable="false"
          decoding="async"
          loading={o.eager ? 'eager' : 'lazy'}
          fetchpriority={o.eager ? 'high' : 'auto'}
        />
      </div>
    </div>
  ))}
</div>

{entrance && <script is:inline>
  {
    const scene = document.currentScript.previousElementSibling;
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      scene.dataset.sceneEntrance = 'boot';
      // Keep the photographs available if the animation module cannot load.
      window.setTimeout(() => {
        if (scene.dataset.sceneEntrance === 'boot') scene.dataset.sceneEntrance = 'complete';
      }, 4000);
    }
  }
</script>}

<script>
  import { enterScene } from '../scripts/scene-entrance';

  const scenes = Array.from(document.querySelectorAll<HTMLElement>('[data-scene]'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  scenes.filter((scene) => scene.hasAttribute('data-scene-entrance')).forEach(enterScene);

  if (scenes.length && !reduced) {
    // How many px an object with depth 1 moves per px the section is off-centre.
    const STRENGTH = 0.12;

    const entries = scenes.map((scene) => ({
      scene,
      objs: Array.from(scene.querySelectorAll<HTMLElement>('.scene-obj')).map((el) => ({
        el,
        depth: parseFloat(el.style.getPropertyValue('--depth')) || 0,
      })),
    }));

    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const { scene, objs } of entries) {
        const r = scene.getBoundingClientRect();
        if (r.bottom < -vh || r.top > vh * 2) continue; // far off-screen, skip
        // How far the section top has scrolled past the viewport top. Zero at
        // load, so declared positions are exact; objects then drift up faster
        // than the page (foreground feel) by depth × STRENGTH.
        const scrolled = Math.max(0, -r.top);
        for (const { el, depth } of objs) {
          el.style.setProperty('--py', `${(-scrolled * depth * STRENGTH).toFixed(1)}px`);
        }
      }
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .scene {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .scene-obj {
    position: absolute;
    left: calc(var(--x) * 100%);
    top: var(--y);
    width: var(--w);
    z-index: var(--z);
    /* Position/parallax, entrance, and static rotation have separate layers. */
    transform: translate(-50%, var(--ty, -50%)) translate3d(0, var(--py, 0px), 0);
    will-change: transform;

    /* Shadow geometry. Light source is top-right, so shadows fall down-left.
       Closer objects (higher --depth) cast longer, softer shadows. */
    --sx: calc(3px + var(--depth) * 5px);
    --sy: calc(4px + var(--depth) * 7px);
  }
  .scene[data-scene-entrance] {
    overflow: clip;
  }
  .scene[data-scene-entrance='boot'] .scene-flight,
  .scene[data-scene-entrance='waiting'] .scene-flight {
    visibility: hidden;
  }
  .scene[data-scene-entrance='entering'] .scene-flight {
    will-change: transform;
  }
  .scene-obj img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    transform: rotate(var(--r));
    /* On the (non-animated) image, not the transformed wrapper: the filtered
       raster is cached once and the compositor only moves it during parallax. */
    filter:
      drop-shadow(calc(var(--sx) * -0.6) calc(var(--sy) * 0.6) 2px rgba(var(--shadow-rgb), 0.12))
      drop-shadow(calc(var(--sx) * -2.2) calc(var(--sy) * 2.2) 14px rgba(var(--shadow-rgb), 0.16));
  }

  @media (max-width: 760px) {
    .scene-obj {
      left: calc(var(--xm) * 100%);
      top: var(--ym);
      width: var(--wm);
      --sx: calc(2px + var(--depth) * 3px);
      --sy: calc(3px + var(--depth) * 4px);
    }
    .scene-obj img {
      transform: rotate(var(--rm));
      filter:
        drop-shadow(calc(var(--sx) * -0.6) calc(var(--sy) * 0.6) 1.5px rgba(var(--shadow-rgb), 0.12))
        drop-shadow(calc(var(--sx) * -2) calc(var(--sy) * 2) 10px rgba(var(--shadow-rgb), 0.16));
    }
    .is-mobile-hidden {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-flight {
      visibility: visible !important;
      transform: none !important;
      will-change: auto !important;
    }
    .scene-obj {
      will-change: auto;
    }
  }
</style>
