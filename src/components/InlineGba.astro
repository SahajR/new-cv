---
import { GameBoyAdvance } from '../icons/gba';
---

<span class="inline-gba" data-inline-gba aria-hidden="true">
  <span class="gba-console">
    <span class="gba-face gba-front"><GameBoyAdvance /></span>
    <span class="gba-face gba-back"><GameBoyAdvance side="back" /></span>
    <span class="gba-edge"></span>
  </span>
</span>

<script>
  import { animate, frame, scroll, type AnimationPlaybackControlsWithThen } from 'motion';

  /* SCROLL STORYBOARD — a single reversible turn, with no idle animation.
   * 84% viewport height: front faces the reader; the flip starts
   * 61% viewport height: back and battery cover face the reader
   * 38% viewport height: full turn complete; front rests at reading height
   */
  const FLIP = {
    start: 0.84, // viewport fraction where the turn begins
    end: 0.38,   // viewport fraction where the turn finishes
    degrees: 360,
  };

  const gba = document.querySelector<HTMLElement>('[data-inline-gba]');

  if (gba) {
    const console = gba.querySelector<HTMLElement>('.gba-console')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const nativeTimeline = 'ViewTimeline' in window;
    let visible = false;
    let raf = 0;
    let playback: AnimationPlaybackControlsWithThen | undefined;
    let detach: (() => void) | undefined;

    const pose = (degrees: number) => `rotateZ(-8deg) rotateX(12deg) rotateY(${degrees}deg)`;
    const bindTimeline = () => {
      detach?.();
      playback?.stop();
      detach = undefined;
      playback = undefined;
      if (reducedMotion.matches) {
        console.style.removeProperty('transform');
        frame.postRender(() => console.style.removeProperty('transform'));
        return;
      }
      // Motion 13 maps its default contain range to a native ViewTimeline. Put the
      // original 84% → 38% timing in keyframes instead of custom offsets,
      // which would force Motion back onto its JavaScript scroll tracker.
      const height = gba.offsetHeight;
      const distance = window.innerHeight - height;
      const start = (window.innerHeight * (1 - FLIP.start) - height / 2) / distance;
      const end = (window.innerHeight * (1 - FLIP.end) - height / 2) / distance;
      playback = animate(console, { transform: [pose(0), pose(0), pose(FLIP.degrees), pose(FLIP.degrees)] }, {
        duration: 1, times: [0, start, end, 1], ease: 'linear',
      });
      detach = scroll(playback, { target: gba });
    };

    const update = () => {
      raf = 0;
      if (!visible || reducedMotion.matches) return;
      // Measure the fixed inline box, never the rotating console within it.
      const rect = gba.getBoundingClientRect();
      const center = rect.top + rect.height / 2;
      const progress = Math.max(0, Math.min(1,
        (window.innerHeight * FLIP.start - center) / (window.innerHeight * (FLIP.start - FLIP.end))
      ));
      console.style.transform = pose(progress * FLIP.degrees);
    };

    const schedule = () => {
      if (visible && !reducedMotion.matches && !raf) raf = requestAnimationFrame(update);
    };

    const syncMotion = () => {
      if (reducedMotion.matches) {
        cancelAnimationFrame(raf);
        raf = 0;
        console.style.removeProperty('transform');
        window.removeEventListener('scroll', schedule);
      } else {
        window.addEventListener('scroll', schedule, { passive: true });
        schedule();
      }
    };

    if (nativeTimeline) {
      // Native timelines follow upstream layout changes without a scroll read.
      new ResizeObserver(bindTimeline).observe(gba);
      window.addEventListener('resize', bindTimeline);
      reducedMotion.addEventListener('change', bindTimeline);
      bindTimeline();
    } else {
      // Keep the existing visibility-gated fallback for older browsers.
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        schedule();
      }, { rootMargin: '40px 0px' }).observe(gba);
      new ResizeObserver(schedule).observe(gba.closest('[data-journey]') ?? gba);
      window.addEventListener('resize', schedule);
      document.fonts.ready.then(schedule);
      reducedMotion.addEventListener('change', syncMotion);
      syncMotion();
    }
  }
</script>

<style>
  .inline-gba {
    display: inline-block;
    position: relative;
    width: 1.9em;
    height: 1.1875em;
    margin-inline: 0.16em 0.12em;
    vertical-align: -0.24em;
    line-height: 0;
    perspective: 160px;
  }

  .gba-console {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateZ(-8deg) rotateX(12deg) rotateY(0deg);
  }

  .gba-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .gba-face :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gba-front {
    transform: translateZ(1px);
  }

  .gba-back {
    transform: rotateY(180deg) translateZ(1px);
  }

  .gba-edge {
    position: absolute;
    inset: 12% 0;
    width: 2px;
    margin-inline: auto;
    border-radius: 1px;
    background: #6a588f;
    transform: rotateY(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .gba-console {
      transform: rotateZ(-8deg) !important;
    }
  }
</style>
