---
import { footerLinks } from '../data/profile';
---

<div class="folio-footer-fx" aria-hidden="true">
  <div class="pb pb1"></div>
  <div class="pb pb2"></div>
  <div class="pb pb3"></div>
  <div class="pb pb4"></div>
  <div class="pb pb5"></div>
  <div class="folio-footer-tint"></div>
</div>

<footer class="folio-footer">
  <div class="folio-footer-inner">
    <nav class="ff-links" aria-label="Footer">
      <button class="ff-link label" type="button" data-scroll-top>
        <span class="ff-link-label">Back to top</span>
      </button>
      {footerLinks.map((l) => (
        <a
          class="ff-link label"
          href={l.href}
          target={l.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={l.href.startsWith('mailto:') ? undefined : 'noreferrer noopener'}
        >
          <span class="ff-link-label">{l.label}</span>
        </a>
      ))}
    </nav>
  </div>
</footer>

<script>
  document.querySelector<HTMLButtonElement>('[data-scroll-top]')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<style>
  .folio-footer,
  .folio-footer-fx {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
  }

  /* Progressive blur: five stacked backdrop layers with rising masks */
  .folio-footer-fx {
    height: 160px;
    z-index: 4;
    pointer-events: none;
  }
  .pb,
  .folio-footer-tint {
    position: absolute;
    inset: 0;
  }
  .pb1 { backdrop-filter: blur(0.6px); -webkit-backdrop-filter: blur(0.6px); mask-image: linear-gradient(to top, #000 0%, #000 92%, transparent 100%); -webkit-mask-image: linear-gradient(to top, #000 0%, #000 92%, transparent 100%); }
  .pb2 { backdrop-filter: blur(1.5px); -webkit-backdrop-filter: blur(1.5px); mask-image: linear-gradient(to top, #000 0%, #000 55%, transparent 80%);  -webkit-mask-image: linear-gradient(to top, #000 0%, #000 55%, transparent 80%); }
  .pb3 { backdrop-filter: blur(3px);   -webkit-backdrop-filter: blur(3px);   mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 60%);  -webkit-mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 60%); }
  .pb4 { backdrop-filter: blur(6px);   -webkit-backdrop-filter: blur(6px);   mask-image: linear-gradient(to top, #000 0%, #000 20%, transparent 42%);  -webkit-mask-image: linear-gradient(to top, #000 0%, #000 20%, transparent 42%); }
  .pb5 { backdrop-filter: blur(12px);  -webkit-backdrop-filter: blur(12px);  mask-image: linear-gradient(to top, #000 0%, #000 8%, transparent 25%);   -webkit-mask-image: linear-gradient(to top, #000 0%, #000 8%, transparent 25%); }
  .folio-footer-tint {
    background: linear-gradient(
      to top,
      rgba(var(--footer-tint-rgb), 0.9),
      rgba(var(--footer-tint-rgb), 0.55) 45%,
      rgba(var(--footer-tint-rgb), 0)
    );
  }

  .folio-footer {
    z-index: 5;
    padding: 44px 0 32px;
  }
  .folio-footer-inner {
    width: min(100% - 3rem, var(--col-w));
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }
  .ff-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 17px;
  }
  .ff-link {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    padding: 2px 10px;
    border-radius: 999px;
    cursor: pointer;
    letter-spacing: 2.16px;
    color: var(--mute);
    text-decoration: none;
    transition:
      color 0.16s var(--ease-out),
      background-color 0.16s var(--ease-out);
  }
  .ff-link:hover {
    color: var(--ink-link-hover);
    background: var(--surface-chip);
  }
  .ff-link-label {
    display: inline-block;
    transition: transform 0.16s var(--ease-out);
  }
  .ff-link:hover .ff-link-label {
    transform: scale(1.05);
  }
  @media (max-width: 620px) {
    .ff-links {
      gap: 4px;
    }
    .ff-link {
      font-size: 10px;
      letter-spacing: 1.1px;
      padding: 2px 6px;
    }
  }
</style>
