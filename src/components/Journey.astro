---
/**
 * The journey path: a rail that zig-zags between the left and right side of
 * the content column, one part per side, lighting up as the reader scrolls.
 *
 * The rail is a single SVG path whose geometry is computed from the real
 * positions of the parts (so it adapts to content and viewport), drawn twice:
 * a dotted base and a solid "lit" stroke clipped at the reading line.
 */
import { journey } from '../data/profile';
import JourneyPart from './JourneyPart.astro';
import RegionWindow from './RegionWindow.astro';
import InterestsWarning from './InterestsWarning.astro';

// Sides alternate continuously across regions.
let globalIndex = 0;
const regions = journey.map((region) => ({
  ...region,
  parts: region.parts.map((part) => ({ part, side: (globalIndex++ % 2 === 0 ? 'left' : 'right') as 'left' | 'right' })),
}));
---

<div class="journey" data-journey data-journey-entrance="complete">
  <svg class="journey-rail" aria-hidden="true" data-journey-svg>
    <defs>
      <linearGradient id="jr-grad" data-journey-grad gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1"></linearGradient>
      <clipPath id="jr-read-clip" clipPathUnits="userSpaceOnUse">
        <rect data-journey-clip x="0" y="0" width="0" height="0" />
      </clipPath>
    </defs>
    <path class="jr-base" data-journey-base d="" />
    <path class="jr-lit" data-journey-lit d="" clip-path="url(#jr-read-clip)" />
  </svg>

  {regions.map((region) => (
    <section class="journey-region" id={region.id} aria-label={region.name} style={`--region-accent: ${region.accent}`}>
      {region.id === 'interests' && <InterestsWarning />}
      <RegionWindow name={region.name} description={region.description} accent={region.accent} />
      <ol class="journey-parts">
        {region.parts.map(({ part, side }, i) => <JourneyPart part={part} side={side} index={i} stopIcon={region.stopIcon} />)}
      </ol>
    </section>
  ))}
</div>

<script is:inline>
  {
    const journey = document.currentScript.previousElementSibling;
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      journey.dataset.journeyEntrance = 'boot';
      window.setTimeout(() => {
        if (journey.dataset.journeyEntrance === 'boot') journey.dataset.journeyEntrance = 'complete';
      }, 4000);
    }
  }
</script>

<script>
  import { frame, scroll } from 'motion';
  import { enterJourney } from '../scripts/journey-entrance';

  const root = document.querySelector<HTMLElement>('[data-journey]');
  const svg = root?.querySelector<SVGSVGElement>('[data-journey-svg]');
  const base = root?.querySelector<SVGPathElement>('[data-journey-base]');
  const lit = root?.querySelector<SVGPathElement>('[data-journey-lit]');
  const clip = root?.querySelector<SVGRectElement>('[data-journey-clip]');

  if (root && svg && base && lit && clip) {
    const parts = Array.from(root.querySelectorAll<HTMLElement>('[data-journey-part]'));
    const dots = parts.map((p) => p.querySelector<HTMLElement>('[data-journey-dot]')!);
    const wins = Array.from(root.querySelectorAll<HTMLElement>('[data-journey-window]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const READ_LINE = 0.42; // fraction of the viewport height that counts as "read"
    const PAD = 40;         // svg bleed beyond the column so the rail isn't clipped

    let rootTop = 0;
    let clipHeight = 0;
    let dotYs: number[] = [];
    let winTops: number[] = [];
    const dotStates: boolean[] = [];
    const windowStates: boolean[] = [];

    const railX = () => parseFloat(getComputedStyle(root).getPropertyValue('--rail-x')) || -22;

    /** Rebuild the path from the current layout. */
    const layout = () => {
      const rr = root.getBoundingClientRect();
      rootTop = rr.top + window.scrollY;
      const w = rr.width + PAD * 2;
      const h = rr.height + PAD;

      const xL = PAD + railX();          // rail left of the column
      const xR = PAD + rr.width - railX(); // rail right of the column (railX is negative)
      const xC = PAD + rr.width / 2;

      // Segments the rail runs straight through, in document order: region
      // windows (entered and exited through their centre) and parts (on
      // their side's rail).
      type Seg = { x: number; top: number; bottom: number };
      const segs: Seg[] = [];
      const regionStops: { winTop: number; winBottom: number; color: string }[] = [];
      root.querySelectorAll<HTMLElement>('.journey-region').forEach((region) => {
        // Resolve the region's rail colour from a part label (theme-aware).
        const label = region.querySelector<HTMLElement>('.jp-label');
        const color = label ? getComputedStyle(label).color : 'currentColor';
        const win = region.querySelector<HTMLElement>('[data-journey-window]');
        if (win) {
          const r = win.getBoundingClientRect();
          segs.push({ x: xC, top: r.top - rr.top, bottom: r.bottom - rr.top });
          regionStops.push({ winTop: r.top - rr.top, winBottom: r.bottom - rr.top, color });
        }
        region.querySelectorAll<HTMLElement>('[data-journey-part]').forEach((p) => {
          const r = p.getBoundingClientRect();
          segs.push({ x: p.dataset.side === 'right' ? xR : xL, top: r.top - rr.top, bottom: r.bottom - rr.top });
        });
      });

      // Finish layout reads before changing any SVG attributes or styles.
      const title = document.querySelector('.folio-intro');
      const startY = title ? Math.min(0, title.getBoundingClientRect().bottom + 14 - rr.top) : 0;
      dotYs = dots.map((dot) => dot.getBoundingClientRect().top + dot.offsetHeight / 2 - rr.top);
      winTops = wins.map((win) => win.getBoundingClientRect().top - rr.top);
      clipHeight = h + window.innerHeight;

      svg.setAttribute('width', `${w}`);
      svg.setAttribute('height', `${h}`);
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      svg.style.left = `${-PAD}px`;
      svg.style.top = '0px';
      clip.setAttribute('width', `${w}`);
      clip.setAttribute('height', `${clipHeight}`);

      // Colour the lit stroke per region: each blend happens across a window
      // band, where the rail is hidden behind the window.
      const grad = svg.querySelector<SVGLinearGradientElement>('[data-journey-grad]');
      if (grad && regionStops.length) {
        grad.setAttribute('y2', `${h}`);
        grad.innerHTML = regionStops
          .map((rs, i) => {
            const prev = regionStops[i - 1];
            return (
              (prev ? `<stop offset="${(rs.winTop / h).toFixed(4)}" stop-color="${prev.color}"></stop>` : '') +
              `<stop offset="${(i === 0 ? 0 : rs.winBottom / h).toFixed(4)}" stop-color="${rs.color}"></stop>`
            );
          })
          .join('');
      }

      /**
       * Orthogonal crossover: continue down to the midpoint of the gap, turn a
       * rounded 90° corner, run horizontally, turn again and head down into
       * the next rail. Arc sweep flags depend on the travel direction.
       */
      const R = 28; // corner radius
      const crossover = (x1: number, x2: number, midY: number) => {
        const r = Math.min(R, Math.abs(x2 - x1) / 2);
        const dir = x2 > x1 ? 1 : -1;
        const sweep1 = dir > 0 ? 0 : 1; // down → horizontal
        const sweep2 = dir > 0 ? 1 : 0; // horizontal → down
        return (
          ` L ${x1} ${midY - r}` +
          ` A ${r} ${r} 0 0 ${sweep1} ${x1 + dir * r} ${midY}` +
          ` L ${x2 - dir * r} ${midY}` +
          ` A ${r} ${r} 0 0 ${sweep2} ${x2} ${midY + r}`
        );
      };

      // Straight drop when two segments share an x; rounded crossover otherwise.
      const join = (x1: number, x2: number, y1: number, y2: number) =>
        Math.abs(x2 - x1) < 1 ? ` L ${x2} ${y2}` : crossover(x1, x2, (y1 + y2) / 2) + ` L ${x2} ${y2}`;

      // Start below the full introduction, including its subtitle.
      const first = segs[0];
      let d = `M ${xC} ${startY}`;
      d += join(xC, first.x, startY, first.top);

      segs.forEach((s, i) => {
        d += ` L ${s.x} ${s.bottom}`;
        const next = segs[i + 1];
        if (next) d += join(s.x, next.x, s.bottom, next.top);
      });
      // Tail
      const last = segs[segs.length - 1];
      d += ` L ${last.x} ${Math.min(h, last.bottom + 24)}`;

      base.setAttribute('d', d);
      lit.setAttribute('d', d);
    };

    const update = (scrollY = window.scrollY) => {
      const lineY = window.innerHeight * READ_LINE + scrollY - rootTop;
      // The rail only travels downward. A horizontal clipping boundary gives
      // the same reading position without sampling the SVG's length or points.
      clip.style.transform = `translateY(${lineY - clipHeight}px)`;
      dots.forEach((dot, i) => {
        const reached = dotYs[i] <= lineY;
        if (dotStates[i] === reached) return;
        dotStates[i] = reached;
        dot.classList.toggle('is-lit', reached);
      });
      wins.forEach((win, i) => {
        const reached = winTops[i] + 24 <= lineY;
        if (windowStates[i] === reached) return;
        windowStates[i] = reached;
        win.classList.toggle('is-reached', reached);
      });
    };
    const relayout = () => {
      layout();
      update();
    };

    /**
     * The region windows animate their height open (a layout animation), so
     * the ResizeObserver fires every frame for ~0.5s. Rebuilding the path and
     * measuring it per frame is unnecessary — instead, relayout at most
     * every 160ms while resizes stream in, plus a trailing pass so the rail
     * settles exactly on the final geometry.
     */
    let relayoutTimer = 0;
    let lastRelayout = 0;
    const scheduleRelayout = () => {
      const now = performance.now();
      if (now - lastRelayout > 160) {
        lastRelayout = now;
        relayout();
      }
      clearTimeout(relayoutTimer);
      relayoutTimer = window.setTimeout(() => {
        lastRelayout = performance.now();
        relayout();
      }, 180);
    };

    // Reveal parts as they enter the viewport
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }),
      { rootMargin: '0px 0px -12% 0px' }
    );
    parts.forEach((p) => (reduced ? p.classList.add('is-in') : io.observe(p)));

    // Motion batches scroll measurements before these writes. The root's
    // document position is cached by layout(), so scrolling needs no rect read.
    scroll((_, info) => update(info.y.current));
    window.addEventListener('resize', scheduleRelayout);
    new ResizeObserver(scheduleRelayout).observe(root);
    document.fonts?.ready.then(() => frame.read(relayout));
    relayout();
    enterJourney(root, relayout);
  }
</script>

<style>
  .journey {
    position: relative;
    width: 100%;
    --rail-x: -22px;      /* rail offset outside the column edge */
    --rail-gutter: 0px;   /* content inset on the rail side (desktop: none needed) */
    margin-top: 1.5rem;
  }
  .journey[data-journey-entrance='boot'],
  .journey[data-journey-entrance='waiting'] {
    opacity: 0;
    visibility: hidden;
  }
  .journey[data-journey-entrance='revealing'] {
    /* Extend the feathered mask around the rail's lead-in and side curves. */
    mask-image: linear-gradient(to bottom, #000 calc(var(--journey-reveal, 0%) - 12%), transparent var(--journey-reveal, 0%));
    mask-size: calc(100% + 192px) calc(100% + 192px);
    mask-position: -96px -96px;
    mask-repeat: no-repeat;
    mask-clip: no-clip;
    will-change: transform, opacity;
  }
  .journey-rail {
    position: absolute;
    top: 0;
    left: -40px;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .jr-base {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: 2 3.5;
  }
  .jr-lit {
    fill: none;
    stroke: url(#jr-grad);
    stroke-width: 1.25;
    stroke-linecap: round;
    filter: drop-shadow(0 0 3px rgba(var(--rail-lit-rgb), 0.2));
  }
  .journey-region {
    display: flex;
    flex-direction: column;
    gap: 56px;
    /* The region's rail colour: its accent, pulled toward ink for contrast
       (and automatically lightened in dark mode, where ink is near-white). */
    --region-rail: color-mix(in oklab, var(--region-accent, var(--rail-lit)) 55%, var(--ink));
  }
  .journey-region + .journey-region {
    margin-top: 72px;
  }
  .journey-region:first-of-type {
    margin-top: 40px; /* room for the lead-in curve above the first cloud */
  }
  .journey-parts {
    position: relative;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(88px, 12vh, 140px); /* room for the crossover curve */
  }

  @media (max-width: 760px) {
    .journey {
      --rail-x: 4px;
      --rail-gutter: 28px;
    }
    .journey-rail {
      left: -40px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .journey[data-journey-entrance] {
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      mask-image: none !important;
      will-change: auto;
    }
  }
</style>
