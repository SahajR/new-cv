---
/**
 * The journey path: a rail that zig-zags between the left and right side of
 * the content column, one part per side, lighting up as the reader scrolls.
 *
 * The rail is a single SVG path whose geometry is computed from the real
 * positions of the parts (so it adapts to content and viewport), drawn twice:
 * a dotted base and a solid "lit" stroke revealed via stroke-dashoffset.
 */
import { journey } from '../data/profile';
import JourneyPart from './JourneyPart.astro';
import RegionWindow from './RegionWindow.astro';

// Sides alternate continuously across regions.
let globalIndex = 0;
const regions = journey.map((region) => ({
  ...region,
  parts: region.parts.map((part) => ({ part, side: (globalIndex++ % 2 === 0 ? 'left' : 'right') as 'left' | 'right' })),
}));
---

<div class="journey" data-journey>
  <svg class="journey-rail" aria-hidden="true" data-journey-svg>
    <path class="jr-base" data-journey-base d="" />
    <path class="jr-lit" data-journey-lit d="" />
  </svg>

  {regions.map((region) => (
    <section class="journey-region" aria-label={region.name}>
      <RegionWindow name={region.name} description={region.description} accent={region.accent} />
      <ol class="journey-parts">
        {region.parts.map(({ part, side }, i) => <JourneyPart part={part} side={side} index={i} />)}
      </ol>
    </section>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-journey]');
  const svg = root?.querySelector<SVGSVGElement>('[data-journey-svg]');
  const base = root?.querySelector<SVGPathElement>('[data-journey-base]');
  const lit = root?.querySelector<SVGPathElement>('[data-journey-lit]');

  if (root && svg && base && lit) {
    const parts = Array.from(root.querySelectorAll<HTMLElement>('[data-journey-part]'));
    const dots = parts.map((p) => p.querySelector<HTMLElement>('[data-journey-dot]')!);
    const wins = Array.from(root.querySelectorAll<HTMLElement>('[data-journey-window]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const READ_LINE = 0.42; // fraction of the viewport height that counts as "read"
    const PAD = 40;         // svg bleed beyond the column so the rail isn't clipped

    let total = 0;
    let samples: { len: number; y: number }[] = [];
    let dotYs: number[] = [];
    let winTops: number[] = [];
    let raf = 0;

    const railX = () => parseFloat(getComputedStyle(root).getPropertyValue('--rail-x')) || -22;

    /** Rebuild the path from the current layout. */
    const layout = () => {
      const rr = root.getBoundingClientRect();
      const w = rr.width + PAD * 2;
      const h = rr.height + PAD;
      svg.setAttribute('width', `${w}`);
      svg.setAttribute('height', `${h}`);
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      svg.style.left = `${-PAD}px`;
      svg.style.top = `0px`;

      const xL = PAD + railX();          // rail left of the column
      const xR = PAD + rr.width - railX(); // rail right of the column (railX is negative)
      const xC = PAD + rr.width / 2;

      // Segments the rail runs straight through, in document order: region
      // windows (entered and exited through their centre) and parts (on
      // their side's rail).
      type Seg = { x: number; top: number; bottom: number };
      const segs: Seg[] = [];
      root.querySelectorAll<HTMLElement>('.journey-region').forEach((region) => {
        const win = region.querySelector<HTMLElement>('[data-journey-window]');
        if (win) {
          const r = win.getBoundingClientRect();
          segs.push({ x: xC, top: r.top - rr.top, bottom: r.bottom - rr.top });
        }
        region.querySelectorAll<HTMLElement>('[data-journey-part]').forEach((p) => {
          const r = p.getBoundingClientRect();
          segs.push({ x: p.dataset.side === 'right' ? xR : xL, top: r.top - rr.top, bottom: r.bottom - rr.top });
        });
      });

      /**
       * Orthogonal crossover: continue down to the midpoint of the gap, turn a
       * rounded 90° corner, run horizontally, turn again and head down into
       * the next rail. Arc sweep flags depend on the travel direction.
       */
      const R = 28; // corner radius
      const crossover = (x1: number, x2: number, midY: number) => {
        const r = Math.min(R, Math.abs(x2 - x1) / 2);
        const dir = x2 > x1 ? 1 : -1;
        const sweep1 = dir > 0 ? 0 : 1; // down → horizontal
        const sweep2 = dir > 0 ? 1 : 0; // horizontal → down
        return (
          ` L ${x1} ${midY - r}` +
          ` A ${r} ${r} 0 0 ${sweep1} ${x1 + dir * r} ${midY}` +
          ` L ${x2 - dir * r} ${midY}` +
          ` A ${r} ${r} 0 0 ${sweep2} ${x2} ${midY + r}`
        );
      };

      // Straight drop when two segments share an x; rounded crossover otherwise.
      const join = (x1: number, x2: number, y1: number, y2: number) =>
        Math.abs(x2 - x1) < 1 ? ` L ${x2} ${y2}` : crossover(x1, x2, (y1 + y2) / 2) + ` L ${x2} ${y2}`;

      // Start immediately below the header title, not at the container top.
      const title = document.querySelector('.folio-tagline');
      const startY = title ? Math.min(0, title.getBoundingClientRect().bottom + 14 - rr.top) : 0;

      const first = segs[0];
      let d = `M ${xC} ${startY}`;
      d += join(xC, first.x, startY, first.top);

      segs.forEach((s, i) => {
        d += ` L ${s.x} ${s.bottom}`;
        const next = segs[i + 1];
        if (next) d += join(s.x, next.x, s.bottom, next.top);
      });
      // Tail
      const last = segs[segs.length - 1];
      d += ` L ${last.x} ${Math.min(h, last.bottom + 24)}`;

      base.setAttribute('d', d);
      lit.setAttribute('d', d);

      total = lit.getTotalLength();
      lit.style.strokeDasharray = `${total}`;

      // Sample the path so scroll → length lookups are cheap (path is monotonic in y).
      const N = 150;
      samples = Array.from({ length: N + 1 }, (_, i) => {
        const len = (total * i) / N;
        return { len, y: lit.getPointAtLength(len).y };
      });
      dotYs = dots.map((dot) => dot.getBoundingClientRect().top + dot.offsetHeight / 2 - rr.top);
      winTops = wins.map((w) => w.getBoundingClientRect().top - rr.top);
    };

    const lengthAtY = (y: number) => {
      if (!samples.length || y <= samples[0].y) return 0;
      for (let i = 1; i < samples.length; i++) {
        if (samples[i].y >= y) {
          const a = samples[i - 1], b = samples[i];
          const t = b.y === a.y ? 0 : (y - a.y) / (b.y - a.y);
          return a.len + (b.len - a.len) * t;
        }
      }
      return total;
    };

    const update = () => {
      raf = 0;
      const rr = root.getBoundingClientRect();
      const lineY = window.innerHeight * READ_LINE - rr.top; // reading line in root coords
      const litLen = lengthAtY(lineY);
      lit.style.strokeDashoffset = `${total - litLen}`;
      dots.forEach((dot, i) => dot.classList.toggle('is-lit', dotYs[i] <= lineY));
      // Windows sit dimmed until the reading line reaches them
      wins.forEach((w, i) => w.classList.toggle('is-reached', winTops[i] + 24 <= lineY));
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    const relayout = () => {
      layout();
      update();
    };

    /**
     * The region windows animate their height open (a layout animation), so
     * the ResizeObserver fires every frame for ~0.5s. Rebuilding the path and
     * resampling it per frame is what causes jank — instead, relayout at most
     * every 160ms while resizes stream in, plus a trailing pass so the rail
     * settles exactly on the final geometry.
     */
    let relayoutTimer = 0;
    let lastRelayout = 0;
    const scheduleRelayout = () => {
      const now = performance.now();
      if (now - lastRelayout > 160) {
        lastRelayout = now;
        relayout();
      }
      clearTimeout(relayoutTimer);
      relayoutTimer = window.setTimeout(() => {
        lastRelayout = performance.now();
        relayout();
      }, 180);
    };

    // Reveal parts as they enter the viewport
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('is-in')),
      { rootMargin: '0px 0px -12% 0px' }
    );
    parts.forEach((p) => (reduced ? p.classList.add('is-in') : io.observe(p)));

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', scheduleRelayout);
    new ResizeObserver(scheduleRelayout).observe(root);
    document.fonts?.ready.then(relayout);
    relayout();
  }
</script>

<style>
  .journey {
    position: relative;
    width: 100%;
    --rail-x: -22px;      /* rail offset outside the column edge */
    --rail-gutter: 0px;   /* content inset on the rail side (desktop: none needed) */
    margin-top: 1.5rem;
  }
  .journey-rail {
    position: absolute;
    top: 0;
    left: -40px;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .jr-base {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: 2 3.5;
  }
  .jr-lit {
    fill: none;
    stroke: var(--rail-lit);
    stroke-width: 1.25;
    stroke-linecap: round;
    filter: drop-shadow(0 0 3px rgba(var(--rail-lit-rgb), 0.25));
    transition: stroke-dashoffset 0.12s linear;
  }
  .journey-region {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .journey-region + .journey-region {
    margin-top: 72px;
  }
  .journey-region:first-of-type {
    margin-top: 40px; /* room for the lead-in curve above the first cloud */
  }
  .journey-parts {
    position: relative;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(88px, 12vh, 140px); /* room for the crossover curve */
  }

  @media (max-width: 760px) {
    .journey {
      --rail-x: 4px;
      --rail-gutter: 28px;
    }
    .journey-rail {
      left: -40px;
    }
  }
</style>
